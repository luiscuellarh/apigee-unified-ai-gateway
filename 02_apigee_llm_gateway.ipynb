    "if rep_s == 200:\n",
    "    titles = {s[\"displayName\"] for s in TARGET_REPORT_SPECS.values()}\n",
    "    for q in rep_d.get(\"qualifier\", []):\n",
    "        q_id = q.get(\"name\", \"\").split(\"/\")[-1]\n",
    "        if q.get(\"displayName\") in titles or q_id in TARGET_REPORT_SPECS:\n",
    "            apigee_request(\"DELETE\", f\"reports/{q_id}\")\n",
    "\n",
    "update_progress(\"Step 3/4: Executing './reports/create-reports.sh' against Apigee Management API...\")\n",
    "sync_env_exports()\n",
    "script_env = {**os.environ, \"PROJECT_ID\": APIGEE_ORG, \"APIGEE_ORG\": APIGEE_ORG}\n",
    "script_env[\"ACCESS_TOKEN\"] = script_env[\"TOKEN\"] = get_access_token(force_refresh=True)\n",
    "run_rep = subprocess.run([\"./reports/create-reports.sh\"], cwd=str(REPO_DIR), env=script_env, capture_output=True, text=True, encoding=\"utf-8\")\n",
    "if run_rep.returncode != 0:\n",
    "    fail_step(\"Script ./reports/create-reports.sh Failed\", f\"Exited with code {run_rep.returncode}.\", \"Verify Apigee Analytics Admin permissions.\", (run_rep.stdout or \"\") + \"\\n\" + (run_rep.stderr or \"\"))\n",
    "\n",
    "update_progress(\"Step 4/4: Verifying deployed FinOps, Latency & Token custom reports...\")\n",
    "deployed_reports: dict[str, dict[str, Any]] = {}\n",
    "ver_s, ver_d = apigee_request(\"GET\", \"reports\")\n",
    "if ver_s == 200:\n",
    "    title_to_key = {s[\"displayName\"]: k for k, s in TARGET_REPORT_SPECS.items()}\n",
    "    for q in ver_d.get(\"qualifier\", []):\n",
    "        q_id = q.get(\"name\", \"\").split(\"/\")[-1]\n",
    "        matched = title_to_key.get(q.get(\"displayName\", \"\")) or (q_id if q_id in TARGET_REPORT_SPECS else None)\n",
    "        if matched and matched not in deployed_reports:\n",
    "            det_s, det_d = apigee_request(\"GET\", f\"reports/{q_id}\")\n",
    "            deployed_reports[matched] = det_d if det_s == 200 else q\n",
    "\n",
    "for r_key, r_spec in TARGET_REPORT_SPECS.items():\n",
    "    if r_key not in deployed_reports:\n",
    "        p_s, p_d = apigee_request(\"POST\", \"reports\", json_body=r_spec)\n",
    "        if p_s in (200, 201):\n",
    "            deployed_reports[r_key] = p_d\n",
    "\n",
    "dc_total = len(REQUIRED_DATA_COLLECTORS)\n",
    "report_rows = [(\"AI Data Collectors (dc_ai_*)\", f\"{dc_total} verified ({created_dcs} newly created)\")]\n",
