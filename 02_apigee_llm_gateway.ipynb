    "def build_quota_policy_panel_html(quota_info: Optional[dict[str, Any]], result: Optional[dict[str, Any]] = None) -> str:\n",
    "    \"\"\"Renders a visual summary table of the API Product & Token Quotas resolved for the active API key.\"\"\"\n",
    "    if not quota_info:\n",
    "        return \"\"\n",
    "    k_st = quota_info.get(\"key_status\", \"\")\n",
    "    k_disp = quota_info.get(\"api_key_display\", \"\")\n",
    "    app_nm = quota_info.get(\"app_name\", \"—\")\n",
    "    src_lbl = quota_info.get(\"source_label\", \"\")\n",
    "    key_badge = \"✅ Approved\" if k_st == \"approved\" else (\"❌ Missing\" if k_st == \"missing\" else \"❌ Invalid / Unauthorized\")\n",
    "    rows_q: list[tuple[str, str]] = [\n",
    "        (\"API Key & Consumer App\", f\"{k_disp} — {key_badge} (App: {app_nm} | Source: {src_lbl})\"),\n",
    "        (\"Bound API Product\", str(quota_info.get(\"product_label\") or \"None\")),\n",
    "        (\"Selected Model Policy\", str(quota_info.get(\"active_model_rule\") or \"—\")),\n",
    "    ]\n",
    "    if result is not None:\n",
    "        usage = result.get(\"usage\") or {}\n",
    "        tot_tok = usage.get(\"total_tokens\")\n",
    "        lim_val = quota_info.get(\"active_quota_limit\")\n",
    "        win_val = quota_info.get(\"active_quota_window\", \"\")\n",
    "        code_val = result.get(\"status_code\", 0)\n",
    "        if code_val == 429:\n",
    "            limit_note = f\"{lim_val:,} tokens / {win_val}\" if isinstance(lim_val, int) and lim_val > 0 else \"configured product window\"\n",
    "            rows_q.append((\"Window Quota Status\", f\"🛑 Throttled at Edge (HTTP 429) — cumulative usage exceeded {limit_note}; 0 new LLM tokens billed\"))\n",
    "        elif isinstance(tot_tok, int) and tot_tok > 0 and isinstance(lim_val, int) and lim_val > 0:\n",
    "            pct = (tot_tok / lim_val) * 100.0\n",
    "            state_hint = (\n",
    "                \"Window budget now saturated — re-running within the current window will trigger HTTP 429!\"\n",
    "                if tot_tok >= lim_val\n",
    "                else f\"Within {win_val} budget (accumulate >{lim_val:,} tokens in {win_val} to trigger HTTP 429)\"\n",
    "            )\n",
    "            rows_q.append((\"Call Token Usage vs. Quota\", f\"{tot_tok:,} / {lim_val:,} tokens ({pct:.1f}% of {win_val} limit) — {state_hint}\"))\n",
    "        elif isinstance(tot_tok, int) and tot_tok > 0 and quota_info.get(\"active_model_status\") == \"allowed_unlimited\":\n",
    "            rows_q.append((\"Call Token Usage vs. Quota\", f\"{tot_tok:,} tokens consumed — Authorized Unlimited Tier (no token cap enforced)\"))\n",
    "    rows_q.append((\"Full API Product Quota Schedule\", str(quota_info.get(\"schedule_summary\") or \"—\")))\n",
    "    trs = \"\".join(f\"<tr><th>{safe_text(k)}</th><td>{safe_text(v)}</td></tr>\" for k, v in rows_q)\n",
    "    return (\n",
    "        f'<div class=\"agw-box\" style=\"background:#f8fafc;border:1px solid #cbd5e1;margin-top:10px;\">'\n",
    "        f'<strong>🔑 API Product &amp; Token Quota Policy (for Given Key):</strong>'\n",
    "        f'<table class=\"agw-table\" style=\"margin-top:8px;\">{trs}</table></div>'\n",
    "    )\n",
    "\n",
    "\n",
    "QUOTA_TELEMETRY_SEGMENTS = (\n",
    "    \"Segment North-Europe Retail-Copilot handles everyday account inquiries in Frankfurt and Belgium with steady morning concurrency, high semantic cache efficiency, predictable prompt lengths, low first-token latency, and zero policy violations across production workloads.\",\n",
    "    \"Segment Iberian Commercial-Treasury supports corporate cash-flow forecasting and liquidity summaries with medium context windows, balanced token consumption, strict regional data residency routing, and consistent sub-second response times.\",\n",
    "    \"Segment UK-Wealth Portfolio-Advisor synthesizes fixed-income and macroeconomic research briefs for relationship managers using multi-paragraph context digests, disciplined output token caps, and automated sensitive-field masking.\",\n",
    "    \"Segment Nordic Claims-Triage classifies commercial property documentation and policy coverage clauses with deterministic schema validation, high throughput batching, and strong cost-per-resolution unit economics.\",\n",
    "    \"Segment Central-Europe Supply-Chain-Planner evaluates supplier lead-time variance and logistics corridor capacity across manufacturing hubs with moderate prompt budgets, regional failover readiness, and predictable hourly token burn.\",\n",
    "    \"Segment Benelux Compliance-Reviewer summarizes regulatory filing checklists and governance audit trails under strict enterprise guardrails, maintaining full quota compliance and clean observability telemetry.\",\n",
    "    \"Segment Alpine Operations-Desk assists site-reliability engineers with incident postmortem drafting, service-level objective tracking, and runbook lookup while keeping median token usage well inside allocated product tiers.\",\n",
    "    \"Segment Mediterranean Merchant-Support powers multilingual onboarding guides and settlement reconciliation explanations with strong cache reuse on recurring questions and zero unauthenticated traffic.\",\n",
    ")\n",
