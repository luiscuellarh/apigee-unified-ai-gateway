    "start_progress(\"Step 0 — Preflight & Global Setup\", \"Step 1/6: Checking & installing Python, CLI, and AFT dependencies...\")\n",
    "\n",
    "\n",
    "def ensure_step0_dependencies() -> tuple[str, str]:\n",
    "    \"\"\"Installs missing Python packages, system CLI tools (curl/git/jq), and AFT.\"\"\"\n",
    "    missing_py = [\n",
    "        pkg for mod, pkg in ((\"requests\", \"requests\"), (\"yaml\", \"pyyaml\"), (\"matplotlib\", \"matplotlib\"))\n",
    "        if importlib.util.find_spec(mod) is None\n",
    "    ]\n",
    "    if missing_py:\n",
    "        missing_list = \", \".join(missing_py)\n",
    "        update_progress(f\"Step 1/6: Installing Python packages ({missing_list})...\")\n",
    "        pip_res = subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"--quiet\", *missing_py], capture_output=True, text=True)\n",
    "        if pip_res.returncode != 0:\n",
    "            fail_step(\"Python Dependency Installation Failed\", f\"Could not install {missing_list}.\", \"Check runtime internet connectivity and re-run Step 0.\", pip_res.stderr)\n",
    "\n",
    "    missing_sys = [c for c in (\"curl\", \"git\", \"jq\") if shutil.which(c) is None]\n",
    "    if missing_sys and shutil.which(\"apt-get\"):\n",
    "        sys_list = \", \".join(missing_sys)\n",
    "        update_progress(f\"Step 1/6: Installing system CLI tools ({sys_list})...\")\n",
    "        subprocess.run([\"apt-get\", \"update\", \"-qq\"], check=False)\n",
    "        subprocess.run([\"apt-get\", \"install\", \"-y\", \"-qq\", *missing_sys], check=False)\n",
    "\n",
    "    if shutil.which(\"gcloud\") is None:\n",
    "        fail_step(\"Google Cloud SDK (gcloud) Missing\", \"The 'gcloud' CLI was not found on PATH.\", \"Run this notebook in Google Colab or install Google Cloud SDK before executing Step 0.\")\n",
    "\n",
    "    os.environ.pop(\"AFT_REPOSITORY\", None)\n",
    "    for bdir in (Path.home() / \".aft\" / \"bin\", Path.home() / \".local\" / \"bin\"):\n",
    "        cur_path = os.environ.get(\"PATH\", \"\")\n",
    "        if str(bdir) not in cur_path.split(os.pathsep):\n",
    "            os.environ[\"PATH\"] = f\"{bdir}{os.pathsep}{cur_path}\"\n",
    "\n",
    "    if shutil.which(\"aft\") is None:\n",
    "        update_progress(\"Step 1/6: Downloading & installing Apigee Templater CLI (aft)...\")\n",
    "        proc = subprocess.run(\n",
    "            [\"bash\", \"-c\", \"curl -fsSL https://raw.githubusercontent.com/apigee/apigee-templater/main/install.sh | sh\"],\n",
    "            capture_output=True, text=True, encoding=\"utf-8\",\n",
    "        )\n",
    "        if proc.returncode != 0:\n",
    "            fail_step(\"AFT CLI Installation Failed\", \"Failed downloading Apigee Templater (aft).\", \"Verify internet access to github.com and re-run Step 0.\", proc.stderr or proc.stdout)\n",
    "\n",
    "    aft_path = shutil.which(\"aft\")\n",
    "    if not aft_path:\n",
    "        fail_step(\"AFT Binary Not Found on PATH\", \"Installer ran, but 'aft' was not found in ~/.aft/bin or ~/.local/bin.\", \"Restart the Colab runtime and re-run Step 0.\")\n",
    "    ver = subprocess.run([aft_path, \"--version\"], capture_output=True, text=True, encoding=\"utf-8\", check=False)\n",
    "    return aft_path, (ver.stdout or ver.stderr or \"ready\").strip()\n",
    "\n",
