    "def deploy_gateway_step(\n",
    "    step_title: str,\n",
    "    template_yaml: str,\n",
    "    proxy_name: str,\n",
    "    undeploy_previous: str = \"\",\n",
    "    feature_patches: Optional[dict[str, dict[str, str]]] = None,\n",
    "    product_yamls: Optional[list[str]] = None,\n",
    "    include_all_repo_products: bool = False,\n",
    "    app_yamls: Optional[list[str]] = None,\n",
    "    extra_rows: Optional[list[tuple[str, str]]] = None,\n",
    ") -> None:\n",
    "    start_progress(step_title, \"Synchronizing repository templates & features...\")\n",
    "    sync_gateway_repo([template_yaml, *(feature_patches or {}).keys(), *(product_yamls or []), *(app_yamls or [])])\n",
    "    rows: list[tuple[str, str]] = list(extra_rows or [])\n",
    "    logs, applied_params = [], []\n",
    "\n",
    "    if undeploy_previous:\n",
    "        rows.append((\"Previous Proxy Cleanup\", undeploy_proxy(undeploy_previous)))\n",
    "\n",
    "    if feature_patches:\n",
    "        update_progress(\"Configuring policy feature parameters...\")\n",
    "    for feat_rel, params in (feature_patches or {}).items():\n",
    "        for k, v in params.items():\n",
    "            if str(v).strip():\n",
    "                GATEWAY_STATE[\"policy_params\"][k] = str(v).strip()\n",
    "        applied_params.extend(patch_yaml_parameters(feat_rel, param_updates=params))\n",
    "\n",
    "    patch_yaml_parameters(template_yaml, param_updates=GATEWAY_STATE[\"policy_params\"], proxy_name=proxy_name)\n",
    "    if applied_params:\n",
    "        rows.append((\"Configured Policy Templates\", \" | \".join(applied_params)))\n",
    "\n",
    "    logs.append(run_aft(template_yaml))\n",
    "    ready_msg = wait_for_proxy_ready(proxy_name)\n",
    "    rows.extend([(\"Deployed Proxy Template\", template_yaml), (\"Runtime Deployment State\", f\"✅ {ready_msg}\")])\n",
    "\n",
    "    products = list(product_yamls or [])\n",
    "    if include_all_repo_products and (REPO_DIR / \"config\" / \"products\").is_dir():\n",
    "        for pf in sorted((REPO_DIR / \"config\" / \"products\").glob(\"*.yaml\")):\n",
    "            rel_pf = str(pf.relative_to(REPO_DIR))\n",
    "            if rel_pf not in products:\n",
    "                products.append(rel_pf)\n",
    "    if products:\n",
    "        for prod_rel in products:\n",
    "            prepare_product_yaml(prod_rel, authorized_proxy=proxy_name)\n",
    "            logs.append(run_aft(prod_rel))\n",
    "        rows.append((\"Deployed API Products\", \", \".join(products)))\n",
    "\n",
    "    if app_yamls:\n",
    "        for app_rel in app_yamls:\n",
    "            logs.append(run_aft(app_rel))\n",
    "        update_progress(\"Retrieving approved Consumer API Key from Apigee...\")\n",
    "        key = fetch_approved_api_key(\"premium-app-key-123\")\n",
    "        GATEWAY_STATE[\"api_key\"] = os.environ[\"CONSUMER_API_KEY\"] = key\n",
    "        rows.extend([(\"Deployed Developer Apps\", \", \".join(app_yamls)), (\"Ready Consumer API Key\", key)])\n",
    "\n",
    "    rows.append((\"Live Completions Endpoint\", GATEWAY_STATE[\"completions_url\"]))\n",
    "    show_status_card(\"PASS\", step_title, \"Proxy and configuration artifacts are deployed and READY.\", rows=rows, raw_details=\"\\n\\n\".join(logs))\n",
    "\n",
    "\n",
    "# --- 7. Gateway Chat Client & Live Backend SSE Streaming Helpers --------------\n",
    "def _extract_choice_text(choices: list[dict[str, Any]], sep: str = \"\") -> tuple[str, Optional[str]]:\n",
    "    ans, reas, fin = [], [], None\n",
    "    for ch in choices:\n",
    "        fin = ch.get(\"finish_reason\") or fin\n",
    "        msg = ch.get(\"delta\") or ch.get(\"message\") or {}\n",
    "        if msg.get(\"content\"):\n",
    "            ans.append(msg[\"content\"])\n",
    "        if msg.get(\"reasoning_content\"):\n",
    "            reas.append(msg[\"reasoning_content\"])\n",
    "    text = sep.join(ans).strip()\n",
    "    if not text and reas:\n",
    "        text = \"[Model used budget on reasoning — increase MAX_TOKENS]\\n\" + sep.join(reas).strip()\n",
    "    return text, fin\n",
    "\n",
    "\n",
    "def _format_model_route(requested: str, resolved: str) -> str:\n",
    "    req_c, res_c = requested.strip(), (resolved or requested).strip()\n",
    "    if res_c and req_c and res_c != req_c and req_c.removeprefix(\"google/\") != res_c.removeprefix(\"google/\"):\n",
    "        return f\"{req_c} → {res_c}\"\n",
    "    return res_c or req_c\n",
    "\n",
    "\n",
    "def call_gateway_chat(\n",
    "    prompt: str,\n",
    "    model: str,\n",
    "    stream: bool = False,\n",
    "    max_tokens: int = 2048,\n",
    "    api_key: str = \"\",\n",
    "    expected_proxy: str = \"\",\n",
    "    manage_progress: bool = True,\n",
    "    progress_prefix: str = \"\",\n",
    ") -> dict[str, Any]:\n",
    "    req_model = model.strip()\n",
    "    pfx = f\"{progress_prefix}: \" if progress_prefix else \"\"\n",
    "    if manage_progress:\n",
    "        mode_lbl = \"Live SSE Stream\" if stream else \"Standard JSON\"\n",
    "        start_progress(f\"Executing AI Gateway Request ({req_model})\", f\"{pfx}Verifying Apigee proxy readiness ({mode_lbl})...\")\n",
    "\n",
    "    target_proxy = expected_proxy or GATEWAY_STATE.get(\"active_proxy\", \"\")\n",
    "    if target_proxy:\n",
    "        wait_for_proxy_ready(target_proxy)\n",
    "\n",
    "    endpoint = GATEWAY_STATE[\"completions_url\"]\n",
    "    headers = {\n",
    "        \"Content-Type\": \"application/json; charset=utf-8\",\n",
    "        \"Accept\": \"text/event-stream\" if stream else \"application/json; charset=utf-8\",\n",
    "        \"Accept-Charset\": \"utf-8\",\n",
    "    }\n",
    "    if stream:\n",
    "        headers[\"Cache-Control\"] = \"no-cache\"\n",
    "    if api_key.strip():\n",
    "        headers[\"x-api-key\"] = api_key.strip()\n",
    "    payload = {\"model\": req_model, \"stream\": bool(stream), \"max_tokens\": int(max_tokens), \"messages\": [{\"role\": \"user\", \"content\": prompt}]}\n",
    "\n",
    "    if stream:\n",
    "        update_progress(f\"{pfx}Opening live SSE stream from backend via '{endpoint}' (model={req_model})...\", badge=\"📡 CONNECTING STREAM\")\n",
    "    else:\n",
    "        update_progress(f\"{pfx}Waiting for AI response from '{req_model}' via Apigee Gateway...\")\n",
    "\n",
    "    t0 = time.perf_counter()\n",
    "    try:\n",
    "        with requests.post(\n",
    "            endpoint, headers=headers, data=json.dumps(payload, ensure_ascii=False).encode(\"utf-8\"), stream=bool(stream), timeout=(15, 180)\n",
    "        ) as resp:\n",
    "            resp.encoding = \"utf-8\"\n",
    "            cached_hdr = (resp.headers.get(\"cached-content\") or resp.headers.get(\"x-apigee-cache\") or resp.headers.get(\"X-Cache-Status\") or \"\").strip()\n",
    "            is_cache_hit = cached_hdr.lower() in (\"true\", \"hit\", \"1\")\n",
    "\n",
    "            if resp.status_code != 200:\n",
    "                raw_err = resp.content.decode(\"utf-8\", errors=\"replace\")\n",
    "                reason = raw_err\n",
    "                try:\n",
    "                    err_obj = json.loads(raw_err)\n",
    "                    if isinstance(err_obj.get(\"error\"), dict):\n",
    "                        reason = err_obj[\"error\"].get(\"message\") or raw_err\n",
    "                    elif isinstance(err_obj.get(\"fault\"), dict):\n",
    "                        reason = err_obj[\"fault\"].get(\"faultstring\") or raw_err\n",
    "                except ValueError:\n",
    "                    pass\n",
    "                return {\n",
    "                    \"ok\": False, \"status_code\": resp.status_code, \"elapsed_ms\": round((time.perf_counter() - t0) * 1000, 1),\n",
    "                    \"resolved_model\": req_model, \"finish_reason\": \"blocked\", \"reply\": \"\", \"usage\": {},\n",
    "                    \"cache_hit\": False, \"cache_header\": cached_hdr, \"streamed\": False, \"sse_chunks\": 0, \"ttft_ms\": 0.0,\n",
    "                    \"error_reason\": reason, \"raw\": raw_err,\n",
    "                }\n",
    "\n",
    "            if stream:\n",
    "                content_parts: list[str] = []\n",
    "                reasoning_parts: list[str] = []\n",
    "                raw_sse_events: list[str] = []\n",
    "                non_sse: list[str] = []\n",
    "                resolved_model = req_model\n",
    "                finish_reason: Optional[str] = None\n",
    "                usage_info: dict[str, Any] = {}\n",
    "                sse_chunks = 0\n",
    "                ttft_ms = 0.0\n",
    "                last_ui_ts = 0.0\n",
    "                prompt_short = safe_text(prompt if len(prompt) <= 220 else prompt[:220] + \"...\")\n",
    "\n",
    "                # chunk_size=1 ensures unbuffered real-time SSE line delivery from the Apigee backend\n",
    "                for raw_line in resp.iter_lines(chunk_size=1, decode_unicode=False):\n",
    "                    if not raw_line:\n",
    "                        continue\n",
    "                    line = raw_line.decode(\"utf-8\", errors=\"replace\").strip() if isinstance(raw_line, (bytes, bytearray)) else str(raw_line).strip()\n",
    "                    if not line or line.startswith((\":\", \"event:\", \"id:\", \"retry:\")):\n",
    "                        continue\n",
    "                    if not line.startswith(\"data:\"):\n",
    "                        non_sse.append(line)\n",
    "                        continue\n",
    "                    raw_sse_events.append(line)\n",
    "                    data_str = line[5:].strip()\n",
    "                    if data_str == \"[DONE]\":\n",
    "                        break\n",
    "                    try:\n",
    "                        chunk = json.loads(data_str)\n",
    "                    except ValueError:\n",
    "                        continue\n",
    "\n",
    "                    sse_chunks += 1\n",
    "                    now_p = time.perf_counter()\n",
    "                    if sse_chunks == 1:\n",
    "                        ttft_ms = round((now_p - t0) * 1000, 1)\n",
    "                    resolved_model = chunk.get(\"model\") or resolved_model\n",
    "                    if chunk.get(\"usage\"):\n",
    "                        usage_info = chunk[\"usage\"]\n",
    "\n",
    "                    for ch in chunk.get(\"choices\", []):\n",
    "                        if ch.get(\"finish_reason\"):\n",
    "                            finish_reason = ch[\"finish_reason\"]\n",
    "                        delta = ch.get(\"delta\") or ch.get(\"message\") or {}\n",
    "                        if delta.get(\"reasoning_content\"):\n",
    "                            reasoning_parts.append(delta[\"reasoning_content\"])\n",
    "                        if delta.get(\"content\"):\n",
    "                            content_parts.append(delta[\"content\"])\n",
    "\n",
    "                    if sse_chunks == 1 or finish_reason or (now_p - last_ui_ts) >= 0.05:\n",
    "                        last_ui_ts = now_p\n",
    "                        live_ms = round((now_p - t0) * 1000, 1)\n",
    "                        route_txt = safe_text(_format_model_route(req_model, resolved_model))\n",
    "                        if content_parts:\n",
    "                            live_txt = safe_text(\"\".join(content_parts))\n",
    "                            stream_stage = \"🤖 Live Backend Stream (SSE):\"\n",
    "                        elif reasoning_parts:\n",
    "                            live_txt = safe_text(\"[Streaming model reasoning tokens...]\\n\" + \"\".join(reasoning_parts)[-600:])\n",
    "                            stream_stage = \"🧠 Backend Model Thinking Stream (SSE):\"\n",
    "                        else:\n",
    "                            live_txt = \"Receiving initial SSE metadata...\"\n",
    "                            stream_stage = \"📡 Live Backend Stream (SSE):\"\n",
    "                        live_html = (\n",
    "                            f'<div class=\"agw-body\"><div class=\"agw-pills\">'\n",
    "                            f'<div class=\"agw-pill\"><strong>SSE Chunks:</strong> {sse_chunks}</div>'\n",
    "                            f'<div class=\"agw-pill\"><strong>TTFT:</strong> {ttft_ms} ms</div>'\n",
    "                            f'<div class=\"agw-pill\"><strong>Elapsed:</strong> {live_ms} ms</div>'\n",
    "                            f'<div class=\"agw-pill\"><strong>Model:</strong> {route_txt}</div>'\n",
    "                            f'</div><div class=\"agw-box agw-box-prompt\"><strong>💬 Prompt:</strong> {prompt_short}</div>'\n",
    "                            f'<div class=\"agw-box agw-box-reply\"><strong>{stream_stage}</strong><br>{live_txt}<span class=\"agw-cursor\">▍</span></div></div>'\n",
    "                        )\n",
    "                        update_progress(\n",
    "                            f\"{pfx}Streaming live SSE tokens from backend ({sse_chunks} chunks, TTFT {ttft_ms} ms)\",\n",
    "                            extra_html=live_html,\n",
    "                            badge=\"📡 STREAMING LIVE\",\n",
    "                        )\n",
    "\n",
    "                reply_text = \"\".join(content_parts).strip()\n",
    "                if not reply_text and reasoning_parts:\n",
    "                    reply_text = \"[Model used budget on reasoning — increase MAX_TOKENS]\\n\" + \"\".join(reasoning_parts).strip()\n",
    "                if not reply_text and non_sse:\n",
    "                    try:\n",
    "                        fb = json.loads(\"\\n\".join(non_sse))\n",
    "                        resolved_model = fb.get(\"model\") or resolved_model\n",
    "                        usage_info = fb.get(\"usage\") or usage_info\n",
    "                        reply_text, finish_reason = _extract_choice_text(fb.get(\"choices\", []), sep=\"\\n\")\n",
    "                    except ValueError:\n",
    "                        reply_text = \"\\n\".join(non_sse)\n",
    "                raw_payload = \"\\n\".join(raw_sse_events[:120]) if raw_sse_events else (\"\\n\".join(non_sse) or reply_text)\n",
    "                streamed_flag = sse_chunks > 0\n",
    "            else:\n",
    "                raw_payload = resp.content.decode(\"utf-8\", errors=\"replace\")\n",
    "                body = json.loads(raw_payload) if raw_payload.strip().startswith(\"{\") else {}\n",
    "                resolved_model, usage_info = body.get(\"model\", req_model), body.get(\"usage\") or {}\n",
    "                reply_text, finish_reason = _extract_choice_text(body.get(\"choices\", []), sep=\"\\n\")\n",
    "                streamed_flag, sse_chunks, ttft_ms = False, 0, 0.0\n",
    "\n",
    "            return {\n",
    "                \"ok\": True, \"status_code\": 200, \"elapsed_ms\": round((time.perf_counter() - t0) * 1000, 1),\n",
    "                \"resolved_model\": resolved_model, \"finish_reason\": finish_reason or \"stop\",\n",
    "                \"reply\": reply_text, \"usage\": usage_info, \"cache_hit\": is_cache_hit,\n",
    "                \"cache_header\": cached_hdr, \"streamed\": streamed_flag, \"sse_chunks\": sse_chunks, \"ttft_ms\": ttft_ms,\n",
    "                \"error_reason\": \"\", \"raw\": raw_payload,\n",
    "            }\n",
    "    except requests.RequestException as exc:\n",
    "        return {\n",
    "            \"ok\": False, \"status_code\": 0, \"elapsed_ms\": round((time.perf_counter() - t0) * 1000, 1),\n",
    "            \"resolved_model\": req_model, \"finish_reason\": \"network_error\", \"reply\": \"\", \"usage\": {},\n",
    "            \"cache_hit\": False, \"cache_header\": \"\", \"streamed\": False, \"sse_chunks\": 0, \"ttft_ms\": 0.0,\n",
    "            \"error_reason\": f\"Network/TLS error reaching '{endpoint}': {exc}\", \"raw\": str(exc),\n",
    "        }\n",
    "\n",
    "\n",
    "def render_test_client_card(\n",
    "    title: str,\n",
    "    scenario: str,\n",
    "    prompt_display: str,\n",
    "    model: str,\n",
    "    result: dict[str, Any],\n",
    "    expect_block: bool = False,\n",
    "    quota_info: Optional[dict[str, Any]] = None,\n",
    ") -> None:\n",
    "    code, usage = result[\"status_code\"], result.get(\"usage\") or {}\n",
    "    p_tok, c_tok, t_tok = usage.get(\"prompt_tokens\", \"—\"), usage.get(\"completion_tokens\", \"—\"), usage.get(\"total_tokens\", \"—\")\n",
    "    resolved_model = result.get(\"resolved_model\") or model\n",
    "    model_route_txt = safe_text(_format_model_route(model, resolved_model))\n",
    "    fix_box = \"\"\n",
    "    reply_safe = safe_text(result[\"reply\"])\n",
    "    err_safe = safe_text(result[\"error_reason\"])\n",
    "    ms_safe = safe_text(result[\"elapsed_ms\"])\n",
    "    raw_safe = safe_text(result[\"raw\"])\n",
    "    is_streamed = bool(result.get(\"streamed\"))\n",
    "    sse_cnt = result.get(\"sse_chunks\", 0)\n",
    "    ttft_val = result.get(\"ttft_ms\", 0.0)\n",
    "    stream_pill = f'<div class=\"agw-pill\"><strong>SSE Stream:</strong> {sse_cnt} chunks (TTFT {ttft_val} ms)</div>' if is_streamed else \"\"\n",
    "    raw_label = f\"View Raw Backend SSE Stream ({sse_cnt} events, UTF-8)\" if is_streamed else \"View Raw Gateway Payload (UTF-8)\"\n",
    "    quota_panel_html = build_quota_policy_panel_html(quota_info, result=result)\n",
    "\n",
    "    if result[\"ok\"]:\n",
    "        badge_cls = \"agw-cache\" if result.get(\"cache_hit\") else \"agw-pass\"\n",
    "        if result.get(\"cache_hit\"):\n",
    "            badge_text = \"⚡ PASS — SEMANTIC CACHE HIT\"\n",
    "        elif is_streamed:\n",
    "            badge_text = \"✅ PASS — STREAMED FROM BACKEND\"\n",
    "        else:\n",
    "            badge_text = \"✅ PASS — AI RESPONSE RECEIVED\"\n",
    "        subtitle = f\"Scenario: {scenario}\"\n",
    "        trunc = \"<br><em>⚠️ Output reached MAX_TOKENS (finish_reason=length). Increase MAX_TOKENS for a longer answer.</em>\" if result.get(\"finish_reason\") == \"length\" else \"\"\n",
    "        resp_hdr = f\"📡 Streamed AI Response (SSE • {sse_cnt} chunks • TTFT {ttft_val} ms • UTF-8 Verified):\" if is_streamed else \"🤖 AI Response (UTF-8 Verified):\"\n",
    "        outcome_box = f'<div class=\"agw-box agw-box-reply\"><strong>{resp_hdr}</strong><br>{reply_safe}{trunc}</div>'\n",
    "    elif code in (400, 401, 403, 422, 429) or expect_block:\n",
    "        badge_cls = \"agw-policy\"\n",
    "        headline = {\n",
    "            400: \"Model Armor Guardrail Blocked Unsafe Prompt / Output\",\n",
    "            401: \"API Key Authentication Blocked Unauthenticated Call\",\n",
    "            403: \"API Product Allow-List Blocked Unauthorized Model\",\n",
    "            429: \"LLM Token Quota Policy Throttled Excess Token Usage\",\n",
    "        }.get(code, f\"Gateway Governance Policy Enforced (HTTP {code})\")\n",
    "        badge_text, subtitle = f\"🛡️ POLICY VERIFIED (HTTP {code})\", f\"Scenario: {scenario} — {headline}\"\n",
    "        outcome_box = f'<div class=\"agw-box agw-box-policy\"><strong>🛡️ Policy Decision ({safe_text(headline)}):</strong><br>{err_safe}</div>'\n",
    "    else:\n",
    "        badge_cls, badge_text, subtitle, outcome_box = \"agw-fail\", f\"❌ FAIL (HTTP {code})\", f\"Scenario: {scenario}\", \"\"\n",
    "        fix_box = (\n",
    "            f'<div class=\"agw-box agw-box-fix\"><strong>🛠️ Plain-Language Troubleshooting:</strong><br>'\n",
    "            f'Reason: {err_safe}<br><br>'\n",
    "            \"1. Verify the deployment cell above completed with ✅ PASS.<br>\"\n",
    "            \"2. Confirm DNS and the managed TLS certificate for APIGEE_HOST are ACTIVE.<br>\"\n",
    "            \"3. Wait 15 seconds if the proxy was just deployed, then click Run (▶) again.</div>\"\n",
    "        )\n",
    "\n",
    "    render_utf8_html(\n",
    "        f'<div class=\"agw-card\"><div class=\"agw-header\"><div><div class=\"agw-title\">{safe_text(title)}</div>'\n",
    "        f'<div class=\"agw-subtitle\">{safe_text(subtitle)}</div></div><span class=\"agw-badge {badge_cls}\">{badge_text}</span></div>'\n",
    "        f'<div class=\"agw-body\"><div class=\"agw-pills\">'\n",
    "        f'<div class=\"agw-pill\"><strong>HTTP Status:</strong> {safe_text(code)}</div>'\n",
    "        f'<div class=\"agw-pill\"><strong>Latency:</strong> {ms_safe} ms</div>'\n",
    "        f'{stream_pill}'\n",
    "        f'<div class=\"agw-pill\"><strong>Model:</strong> {model_route_txt}</div>'\n",
    "        f'<div class=\"agw-pill\"><strong>Tokens (In / Out / Total):</strong> {safe_text(p_tok)} / {safe_text(c_tok)} / {safe_text(t_tok)}</div>'\n",
    "        f'</div>{quota_panel_html}<div class=\"agw-box agw-box-prompt\"><strong>💬 Prompt Sent:</strong><br>{safe_text(prompt_display)}</div>'\n",
    "        f'{outcome_box}{fix_box}<details class=\"agw-details\"><summary>{raw_label}</summary>'\n",
    "        f'<pre>{raw_safe}</pre></details></div></div>'\n",
    "    )\n",
    "\n",
    "\n",
    "# --- 8. Execute Step 0 Preflight & Background Service Account Provisioning ----\n",
    "def ensure_iam_bindings(get_url: str, set_url: str, pairs: list[tuple[str, str]]) -> None:\n",
    "    for _ in range(5):\n",
    "        status, policy = gcp_json_request(\"POST\", get_url, json_body={})\n",
    "        if status != 200:\n",
    "            time.sleep(2)\n",
    "            continue\n",
    "        bindings, changed = policy.setdefault(\"bindings\", []), False\n",
    "        for member, role in pairs:\n",
    "            entry = next((b for b in bindings if b.get(\"role\") == role and not b.get(\"condition\")), None)\n",
    "            if entry and member in entry.get(\"members\", []):\n",
    "                continue\n",
    "            (entry.setdefault(\"members\", []).append(member)) if entry else bindings.append({\"role\": role, \"members\": [member]})\n",
    "            changed = True\n",
    "        if not changed:\n",
    "            return\n",
    "        set_s, _ = gcp_json_request(\"POST\", set_url, json_body={\"policy\": policy})\n",
    "        if set_s == 200:\n",
    "            return\n",
    "        time.sleep(3)\n",
    "\n",
    "\n",
    "def run_step0_preflight() -> None:\n",
    "    global SERVICE_ACCOUNT, APIGEE_HOST\n",
    "    update_progress(\"Step 2/6: Synchronizing Apigee Unified AI Gateway repository...\")\n",
    "    num_templates, num_features = sync_gateway_repo()\n",
    "\n",
    "    if not APIGEE_ORG or APIGEE_ORG == \"my-gcp-project\":\n",
    "        fail_step(\n",
    "            \"Step 0 Preflight — Enter Your Apigee Organization Name\",\n",
    "            f\"All dependencies & AFT ({AFT_VERSION}) are installed and {num_templates} templates are synced, but APIGEE_ORG is still 'my-gcp-project'.\",\n",
    "            \"Update APIGEE_ORG (and APIGEE_HOST if needed) in Step 0 above and click Run (▶) again. The Service Account will be created automatically in the background.\",\n",
    "        )\n",
    "\n",
    "    update_progress(\"Step 3/6: Authenticating with Google Cloud & enabling required APIs...\")\n",
    "    if \"google.colab\" in sys.modules:\n",
    "        from google.colab import auth\n",
    "        auth.authenticate_user()\n",
    "\n",
    "    subprocess.run([\"gcloud\", \"config\", \"set\", \"project\", PROJECT_ID, \"--quiet\"], capture_output=True, text=True)\n",
    "    active_id = subprocess.run([\"gcloud\", \"config\", \"get-value\", \"account\"], capture_output=True, text=True).stdout.strip()\n",
    "    if not active_id:\n",
    "        _, t_info = gcp_json_request(\"GET\", f\"https://oauth2.googleapis.com/tokeninfo?access_token={get_access_token()}\")\n",
    "        active_id = t_info.get(\"email\", \"authenticated-user\")\n",
    "\n",
    "    req_apis = [\n",
    "        \"apigee.googleapis.com\", \"cloudresourcemanager.googleapis.com\", \"iam.googleapis.com\",\n",
    "        \"iamcredentials.googleapis.com\", \"aiplatform.googleapis.com\", \"modelarmor.googleapis.com\", \"dlp.googleapis.com\",\n",
    "    ]\n",
    "    disabled = [s for s in req_apis if gcp_json_request(\"GET\", f\"https://serviceusage.googleapis.com/v1/projects/{PROJECT_ID}/services/{s}\")[1].get(\"state\") != \"ENABLED\"]\n",
    "    if disabled:\n",
    "        gcp_json_request(\"POST\", f\"https://serviceusage.googleapis.com/v1/projects/{PROJECT_ID}/services:batchEnable\", json_body={\"serviceIds\": disabled})\n",
    "        time.sleep(3)\n",
    "\n",
    "    update_progress(f\"Step 4/6: Validating Apigee Organization '{APIGEE_ORG}', Environment '{APIGEE_ENVIRONMENT}' & Hostname...\")\n",
    "    org_s, org_d = apigee_request(\"GET\", \"\")\n",
    "    org_state = org_d.get(\"state\")\n",
    "    if org_s != 200 or org_state != \"ACTIVE\":\n",
    "        fail_step(f\"Apigee Organization '{APIGEE_ORG}' Is Not Active\", f\"HTTP {org_s} (state={org_state}).\", \"Check APIGEE_ORG in Step 0 and verify Apigee Admin access.\", json.dumps(org_d, indent=2))\n",
    "\n",
    "    env_s, env_d = apigee_request(\"GET\", f\"environments/{APIGEE_ENVIRONMENT}\")\n",
    "    if env_s != 200:\n",
    "        fail_step(f\"Apigee Environment '{APIGEE_ENVIRONMENT}' Not Found\", f\"HTTP {env_s} in org '{APIGEE_ORG}'.\", \"Verify APIGEE_ENVIRONMENT in Step 0 (e.g., 'dev', 'eval', or 'prod').\", json.dumps(env_d, indent=2))\n",
    "\n",
    "    _, eg_list = apigee_request(\"GET\", \"envgroups\")\n",
    "    matched_eg, discovered_hosts = \"\", []\n",
    "    for eg in eg_list.get(\"environmentGroups\", []):\n",
    "        eg_name = eg.get(\"name\", \"\")\n",
    "        _, att_d = apigee_request(\"GET\", f\"envgroups/{eg_name}/attachments\")\n",
    "        if APIGEE_ENVIRONMENT in [a.get(\"environment\") for a in att_d.get(\"environmentGroupAttachments\", [])]:\n",
    "            matched_eg, discovered_hosts = eg_name, eg.get(\"hostnames\", [])\n",
    "            break\n",
    "\n",
    "    if (not APIGEE_HOST or \"example.com\" in APIGEE_HOST) and discovered_hosts:\n",
    "        APIGEE_HOST = discovered_hosts[0]\n",
    "    if not APIGEE_HOST or \"example.com\" in APIGEE_HOST:\n",
    "        fail_step(\"Gateway Hostname Needs Your Real Apigee Domain\", f\"APIGEE_HOST is '{APIGEE_HOST}' and no Environment Group hostname was auto-discovered.\", \"Set APIGEE_HOST in Step 0 to your Apigee Environment Group hostname.\")\n",
    "\n",
    "    GATEWAY_STATE.update({\"host\": APIGEE_HOST, \"completions_url\": f\"https://{APIGEE_HOST}/v1/chat/completions\", \"env_group\": matched_eg or \"custom\"})\n",
    "    sync_env_exports()\n",
    "\n",
    "    _, proj_d = gcp_json_request(\"GET\", f\"https://cloudresourcemanager.googleapis.com/v1/projects/{PROJECT_ID}\")\n",
    "    proj_num = str(proj_d.get(\"projectNumber\", \"\"))\n",
    "\n",
    "    # Automatically verify or create SERVICE_ACCOUNT in the background\n",
    "    update_progress(f\"Step 5/6: Verifying or creating background Service Account '{SERVICE_ACCOUNT}'...\")\n",
    "    sa_url = f\"https://iam.googleapis.com/v1/projects/{PROJECT_ID}/serviceAccounts/{SERVICE_ACCOUNT}\"\n",
    "    sa_s, sa_d = gcp_json_request(\"GET\", sa_url)\n",
    "    sa_label = \"Verified Existing\"\n",
    "    if sa_s == 404:\n",
    "        c_s, c_d = gcp_json_request(\n",
    "            \"POST\", f\"https://iam.googleapis.com/v1/projects/{PROJECT_ID}/serviceAccounts\",\n",
    "            json_body={\n",
    "                \"accountId\": SA_ACCOUNT_ID,\n",
    "                \"serviceAccount\": {\"displayName\": \"Apigee Unified AI Gateway SA\", \"description\": \"Managed runtime SA for Apigee AI Gateway\"},\n",
    "            },\n",
    "        )\n",
    "        if c_s not in (200, 201, 409):\n",
    "            fail_step(\n",
    "                f\"Could Not Auto-Create Service Account '{SERVICE_ACCOUNT}'\",\n",
    "                f\"IAM API returned HTTP {c_s}.\",\n",
    "                \"Ensure your Google Cloud user has Service Account Admin (roles/iam.serviceAccountAdmin) on APIGEE_ORG and re-run Step 0.\",\n",
    "                json.dumps(c_d, indent=2),\n",
    "            )\n",
    "        if c_s in (200, 201):\n",
    "            SERVICE_ACCOUNT = c_d.get(\"email\", SERVICE_ACCOUNT)\n",
    "        sa_label = \"Created in Background\"\n",
    "        sync_env_exports()\n",
    "        for _ in range(6):\n",
    "            chk_s, _ = gcp_json_request(\"GET\", f\"https://iam.googleapis.com/v1/projects/{PROJECT_ID}/serviceAccounts/{SERVICE_ACCOUNT}\")\n",
    "            if chk_s == 200:\n",
    "                break\n",
    "            time.sleep(2)\n",
    "    elif sa_s == 200 and sa_d.get(\"disabled\", False):\n",
    "        gcp_json_request(\"POST\", f\"{sa_url}:enable\", json_body={})\n",
    "        sa_label = \"Re-enabled in Background\"\n",
    "    elif sa_s != 200:\n",
    "        fail_step(f\"Service Account '{SERVICE_ACCOUNT}' Check Failed\", f\"IAM API returned HTTP {sa_s}.\", \"Verify IAM permissions on APIGEE_ORG and re-run Step 0.\", json.dumps(sa_d, indent=2))\n",
    "\n",
    "    update_progress(\"Step 6/6: Applying project & Service Account IAM bindings...\")\n",
    "    proj_iam_pairs = [\n",
    "        (f\"serviceAccount:{SERVICE_ACCOUNT}\", r)\n",
    "        for r in (\n",
    "            \"roles/aiplatform.user\",\n",
    "            \"roles/iam.serviceAccountTokenCreator\",\n",
    "            \"roles/modelarmor.user\",\n",
    "            \"roles/modelarmor.viewer\",\n",
    "            \"roles/dlp.user\",\n",
    "            \"roles/dlp.reader\",\n",
    "        )\n",
    "    ]\n",
    "    if proj_num:\n",
    "        apigee_p4sa = f\"serviceAccount:service-{proj_num}@gcp-sa-apigee.iam.gserviceaccount.com\"\n",
    "        proj_iam_pairs.extend([\n",
    "            (apigee_p4sa, \"roles/modelarmor.user\"),\n",
    "            (apigee_p4sa, \"roles/modelarmor.viewer\"),\n",
    "            (apigee_p4sa, \"roles/dlp.user\"),\n",
    "            (apigee_p4sa, \"roles/dlp.reader\"),\n",
    "        ])\n",
    "    ensure_iam_bindings(\n",
    "        f\"https://cloudresourcemanager.googleapis.com/v1/projects/{PROJECT_ID}:getIamPolicy\",\n",
    "        f\"https://cloudresourcemanager.googleapis.com/v1/projects/{PROJECT_ID}:setIamPolicy\",\n",
    "        proj_iam_pairs,\n",
    "    )\n",
    "    caller_kind = \"serviceAccount\" if active_id.endswith(\".gserviceaccount.com\") else \"user\"\n",
    "    sa_pairs = [\n",
    "        (f\"serviceAccount:{SERVICE_ACCOUNT}\", \"roles/iam.serviceAccountTokenCreator\"),\n",
    "        (f\"serviceAccount:{SERVICE_ACCOUNT}\", \"roles/iam.serviceAccountUser\"),\n",
    "        (f\"{caller_kind}:{active_id}\", \"roles/iam.serviceAccountUser\"),\n",
    "    ]\n",
    "    if proj_num:\n",
    "        sa_pairs.append((f\"serviceAccount:service-{proj_num}@gcp-sa-apigee.iam.gserviceaccount.com\", \"roles/iam.serviceAccountTokenCreator\"))\n",
    "    ensure_iam_bindings(\n",
    "        f\"https://iam.googleapis.com/v1/projects/{PROJECT_ID}/serviceAccounts/{SERVICE_ACCOUNT}:getIamPolicy\",\n",
    "        f\"https://iam.googleapis.com/v1/projects/{PROJECT_ID}/serviceAccounts/{SERVICE_ACCOUNT}:setIamPolicy\",\n",
    "        sa_pairs,\n",
    "    )\n",
    "\n",
    "    proj_display = proj_num or \"verified\"\n",
    "    eg_display = GATEWAY_STATE[\"env_group\"]\n",
    "    show_status_card(\n",
    "        \"PASS\",\n",
    "        \"Step 0 Complete — Dependencies, AFT & Background SA Ready\",\n",
    "        \"All CLI dependencies, background Service Account IAM bindings, and Apigee runtime endpoints are verified.\",\n",
    "        rows=[\n",
    "            (\"Apigee Org / GCP Project\", f\"{APIGEE_ORG} (Project #{proj_display})\"),\n",
    "            (\"Authenticated Identity\", active_id),\n",
    "            (\"Apigee Env / Instance Location\", f\"{APIGEE_ENVIRONMENT} / {APIGEE_INSTANCELOCATION} (envgroup={eg_display})\"),\n",
    "            (\"Live Gateway Completions URL\", GATEWAY_STATE[\"completions_url\"]),\n",
    "            (\"Background Service Account\", f\"{SERVICE_ACCOUNT} ({sa_label}, <GoogleAccessToken> ready)\"),\n",
    "            (\"Vertex Region & Default Model\", f\"{VERTEX_MODEL} @ {REGION}\"),\n",
    "            (\"Apigee Templater CLI (aft)\", f\"{AFT_VERSION} ({AFT_BIN})\"),\n",
    "            (\"Synced Gateway Repository\", f\"{REPO_DIR.name} ({num_templates} templates, {num_features} features)\"),\n",
    "        ],\n",
    "    )\n",
    "\n",
    "\n",
    "run_step0_preflight()"
   ],
   "execution_count": null,
   "outputs": []
  },
