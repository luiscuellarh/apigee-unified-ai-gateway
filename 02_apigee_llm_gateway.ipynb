    "# --- 5. Google Cloud & Apigee API Helpers (Strict UTF-8) ----------------------\n",
    "_TOKEN_CACHE: dict[str, Any] = {\"token\": \"\", \"ts\": 0.0}\n",
    "\n",
    "\n",
    "def get_access_token(force_refresh: bool = False) -> str:\n",
    "    now = time.time()\n",
    "    if not force_refresh and _TOKEN_CACHE[\"token\"] and (now - _TOKEN_CACHE[\"ts\"]) < 300:\n",
    "        return _TOKEN_CACHE[\"token\"]\n",
    "    tok = subprocess.check_output([\"gcloud\", \"auth\", \"print-access-token\"], text=True, encoding=\"utf-8\").strip()\n",
    "    _TOKEN_CACHE.update({\"token\": tok, \"ts\": now})\n",
    "    os.environ[\"TOKEN\"] = os.environ[\"ACCESS_TOKEN\"] = tok\n",
    "    return tok\n",
    "\n",
    "\n",
    "def gcp_json_request(\n",
    "    method: str,\n",
    "    url: str,\n",
    "    json_body: Optional[dict[str, Any]] = None,\n",
    "    params: Optional[dict[str, Any]] = None,\n",
    "    timeout: int = 30,\n",
    "    extra_headers: Optional[dict[str, str]] = None,\n",
    ") -> tuple[int, dict[str, Any]]:\n",
    "    headers = {\"Accept\": \"application/json; charset=utf-8\", \"Accept-Charset\": \"utf-8\"}\n",
    "    if json_body is not None:\n",
    "        headers[\"Content-Type\"] = \"application/json; charset=utf-8\"\n",
    "    if extra_headers:\n",
    "        headers.update(extra_headers)\n",
    "    resp = None\n",
    "    try:\n",
    "        for refresh in (False, True):\n",
    "            headers[\"Authorization\"] = f\"Bearer {get_access_token(force_refresh=refresh)}\"\n",
    "            resp = requests.request(method, url, headers=headers, params=params, json=json_body, timeout=timeout)\n",
    "            if resp.status_code != 401:\n",
    "                break\n",
    "        assert resp is not None\n",
    "        resp.encoding = \"utf-8\"\n",
    "        data = resp.json() if resp.text.strip() else {}\n",
    "        return resp.status_code, (data if isinstance(data, dict) else {\"items\": data})\n",
    "    except ValueError:\n",
    "        return (resp.status_code if resp is not None else 0), {\"raw\": resp.text if resp is not None else \"\"}\n",
    "    except requests.RequestException as exc:\n",
    "        return 0, {\"error\": str(exc), \"url\": url}\n",
    "\n",
    "\n",
    "def apigee_request(\n",
    "    method: str, rel_path: str, json_body: Optional[dict[str, Any]] = None, params: Optional[dict[str, Any]] = None\n",
    ") -> tuple[int, dict[str, Any]]:\n",
    "    clean_rel = rel_path.lstrip(\"/\")\n",
    "    url = rel_path if rel_path.startswith(\"http\") else f\"{APIGEE_MGMT_BASE}/{clean_rel}\"\n",
    "    return gcp_json_request(method, url, json_body=json_body, params=params)\n",
    "\n",
    "\n",
    "# --- 6. Repository Sync, YAML Patching & AFT Deployment Engine ----------------\n",
    "def sync_gateway_repo(required_rel_paths: Optional[list[str]] = None) -> tuple[int, int]:\n",
    "    if (REPO_DIR / \".git\").is_dir():\n",
    "        missing = [p for p in (required_rel_paths or []) if not (REPO_DIR / p).is_file()]\n",
    "        if missing:\n",
    "            subprocess.run([\"git\", \"-C\", str(REPO_DIR), \"fetch\", \"origin\", REPO_BRANCH], capture_output=True, text=True)\n",
    "            for rel_p in missing:\n",
    "                subprocess.run([\"git\", \"-C\", str(REPO_DIR), \"checkout\", f\"origin/{REPO_BRANCH}\", \"--\", rel_p], capture_output=True, text=True)\n",
    "    else:\n",
    "        if REPO_DIR.exists():\n",
    "            shutil.rmtree(REPO_DIR)\n",
    "        proc = subprocess.run(\n",
    "            [\"git\", \"clone\", \"--depth\", \"1\", \"--branch\", REPO_BRANCH, REPO_URL, str(REPO_DIR)],\n",
    "            capture_output=True, text=True, encoding=\"utf-8\",\n",
    "        )\n",
    "        if proc.returncode != 0:\n",
    "            fail_step(\"Failed to Clone Gateway Repository\", f\"Could not clone {REPO_URL}.\", \"Check internet access and re-run Step 0.\", proc.stderr or proc.stdout)\n",
    "    return len(list((REPO_DIR / \"templates").glob(\"*.yaml\"))), len(list((REPO_DIR / \"features\").glob(\"*.yaml\")))\n",
    "\n",
    "\n",
    "def patch_yaml_parameters(rel_path: str, param_updates: Optional[dict[str, str]] = None, proxy_name: Optional[str] = None) -> list[str]:\n",
    "    target = REPO_DIR / rel_path\n",
    "    if not target.is_file():\n",
    "        fail_step(f\"Missing File: {rel_path}\", f\"Expected '{target}' in cloned repository.\", \"Re-run Step 0 to synchronize the repository.\")\n",
    "    text = target.read_text(encoding=\"utf-8\")\n",
    "    applied: list[str] = []\n",
    "    if proxy_name:\n",
    "        text = re.sub(r\"(?m)^name:\\s*.*$\", f\"name: {proxy_name}\", text, count=1)\n",
    "    for k, v in (param_updates or {}).items():\n",
    "        clean_v = str(v).strip()\n",
    "        if clean_v:\n",
    "            pat = rf\"(?i)(-\\s*name:\\s*{re.escape(k)}\\s*\\n\\s*default:\\s*)([^\\n]+)\"\n",
    "            text, cnt = re.subn(pat, rf\"\\g<1>{clean_v}\", text)\n",
    "            if cnt:\n",
    "                applied.append(f\"{k}={clean_v}\")\n",
    "    if \"anonymization-sdp\" in rel_path and REGION:\n",
    "        text = re.sub(\n",
    "            r\"(https://dlp\\.googleapis\\.com/v2/projects/\\{GoogleCloudProject\\}/locations/)[^/\\\"']+(\\/content:deidentify)\",\n",
    "            rf\"\\g<1>{REGION}\\g<2>\",\n",
    "            text,\n",
    "        )\n",
    "    target.write_text(text, encoding=\"utf-8\")\n",
    "    return applied\n",
    "\n",
    "\n",
    "def prepare_product_yaml(rel_path: str, authorized_proxy: str) -> None:\n",
    "    prod_path = REPO_DIR / rel_path\n",
    "    if not prod_path.is_file():\n",
    "        return\n",
    "    raw_text = prod_path.read_text(encoding=\"utf-8\")\n",
    "    try:\n",
    "        doc = yaml.safe_load(raw_text)\n",
    "    except yaml.YAMLError:\n",
    "        doc = None\n",
    "    if not isinstance(doc, dict):\n",
    "        if not re.search(rf\"(?m)^\\s*-\\s*{re.escape(APIGEE_ENVIRONMENT)}\\s*$\", raw_text):\n",
    "            raw_text = re.sub(r\"(?m)^(\\s*environments:\\s*\\n)\", rf\"\\g<1>  - {APIGEE_ENVIRONMENT}\\n\", raw_text, count=1)\n",
    "        prod_path.write_text(raw_text, encoding=\"utf-8\")\n",
    "        return\n",
    "\n",
    "    envs = [str(e).strip() for e in (doc.get(\"environments\") or []) if str(e).strip()]\n",
    "    if APIGEE_ENVIRONMENT not in envs:\n",
    "        envs.append(APIGEE_ENVIRONMENT)\n",
    "    doc[\"environments\"] = envs\n",
    "\n",
    "    proxies = [str(p).strip() for p in (doc.get(\"proxies\") or []) if str(p).strip()]\n",
    "    if authorized_proxy and authorized_proxy not in proxies:\n",
    "        proxies.append(authorized_proxy)\n",
    "    doc[\"proxies\"] = list(dict.fromkeys(proxies))\n",
    "\n",
    "    llm_ops = doc.get(\"llmOperations\")\n",
    "    if isinstance(llm_ops, list) and authorized_proxy:\n",
    "        existing_models_for_target: set[str] = set()\n",
    "        donor_entries: list[dict[str, Any]] = []\n",
    "        for item in llm_ops:\n",
    "            if not isinstance(item, dict):\n",
    "                continue\n",
    "            src = str(item.get(\"apiSource\") or \"\").strip()\n",
    "            ops_sub = item.get(\"operations\") or ([item] if item.get(\"model\") else [])\n",
    "            models_in_item = [str(op.get(\"model\") or \"\").strip() for op in ops_sub if isinstance(op, dict) and op.get(\"model\")]\n",
    "            if src == authorized_proxy:\n",
    "                existing_models_for_target.update(models_in_item)\n",
    "            elif src.startswith(\"llm-gateway-completions-auth\"):\n",
    "                donor_entries.append(item)\n",
    "\n",
    "        for donor in donor_entries:\n",
    "            ops_sub = donor.get(\"operations\") or ([donor] if donor.get(\"model\") else [])\n",
    "            donor_models = [str(op.get(\"model\") or \"\").strip() for op in ops_sub if isinstance(op, dict) and op.get(\"model\")]\n",
    "            if donor_models and not set(donor_models).issubset(existing_models_for_target):\n",
    "                cloned = json.loads(json.dumps(donor))\n",
    "                cloned[\"apiSource\"] = authorized_proxy\n",
    "                llm_ops.append(cloned)\n",
    "                existing_models_for_target.update(donor_models)\n",
    "\n",
    "    prod_path.write_text(yaml.safe_dump(doc, sort_keys=False, allow_unicode=True), encoding=\"utf-8\")\n",
    "\n",
    "\n",
    "def undeploy_proxy(proxy_name: str) -> str:\n",
    "    update_progress(f\"Checking active revisions of '{proxy_name}' in '{APIGEE_ENVIRONMENT}'...\")\n",
    "    dep_path = f\"environments/{APIGEE_ENVIRONMENT}/apis/{proxy_name}/deployments\"\n",
    "    status, data = apigee_request(\"GET\", dep_path)\n",
    "    deployments = data.get(\"deployments\", []) if status == 200 else []\n",
    "    if not deployments:\n",
    "        return f\"{proxy_name} (not currently deployed)\"\n",
    "    revs: list[str] = []\n",
    "    for dep in deployments:\n",
    "        rev = str(dep.get(\"revision\", \"\"))\n",
    "        if rev:\n",
    "            update_progress(f\"Undeploying '{proxy_name}' revision {rev} from '{APIGEE_ENVIRONMENT}'...\")\n",
    "            u_s, u_d = apigee_request(\"DELETE\", f\"environments/{APIGEE_ENVIRONMENT}/apis/{proxy_name}/revisions/{rev}/deployments\")\n",
    "            if u_s not in (200, 204):\n",
    "                fail_step(f\"Could Not Undeploy '{proxy_name}'\", f\"HTTP {u_s} undeploying revision {rev}.\", \"Check Apigee Environment Admin permissions.\", json.dumps(u_d, indent=2))\n",
    "            revs.append(rev)\n",
    "    for poll_idx in range(24):\n",
    "        chk_s, chk_d = apigee_request(\"GET\", dep_path)\n",
    "        if chk_s != 200 or not chk_d.get(\"deployments\"):\n",
    "            break\n",
    "        update_progress(f\"Waiting for '{proxy_name}' undeployment to drain (check {poll_idx + 1}/24)...\")\n",
    "        time.sleep(3)\n",
    "    rev_list = \", \".join(revs)\n",
    "    return f\"Undeployed {proxy_name} (rev {rev_list})\"\n",
    "\n",
    "\n",
    "def wait_for_proxy_ready(proxy_name: str, timeout_sec: int = 180) -> str:\n",
    "    list_path = f\"environments/{APIGEE_ENVIRONMENT}/apis/{proxy_name}/deployments\"\n",
    "    deadline = time.time() + timeout_sec\n",
    "    last_rev, last_state = \"?\", \"WAITING_FOR_DEPLOYMENT\"\n",
    "    while time.time() < deadline:\n",
    "        s_list, d_list = apigee_request(\"GET\", list_path)\n",
    "        deployments = d_list.get(\"deployments\", []) if s_list == 200 else []\n",
    "        if deployments:\n",
    "            latest = sorted(deployments, key=lambda d: int(d.get(\"revision\", 0)))[-1]\n",
    "            last_rev = str(latest.get(\"revision\", \"?\"))\n",
    "            s_rev, d_rev = apigee_request(\"GET\", f\"environments/{APIGEE_ENVIRONMENT}/apis/{proxy_name}/revisions/{last_rev}/deployments\")\n",
    "            last_state = d_rev.get(\"state\", latest.get(\"state\", \"UNKNOWN\")) if s_rev == 200 else \"UNKNOWN\"\n",
    "            if last_state == \"READY\":\n",
    "                GATEWAY_STATE[\"active_proxy\"] = proxy_name\n",
    "                return f\"{proxy_name} (rev {last_rev}) — READY\"\n",
    "        update_progress(f\"Waiting for proxy '{proxy_name}' in '{APIGEE_ENVIRONMENT}' (rev={last_rev}, state={last_state})...\")\n",
    "        time.sleep(4)\n",
    "    fail_step(f\"Proxy '{proxy_name}' Timed Out\", f\"Not READY after {timeout_sec}s (rev={last_rev}, state={last_state}).\", \"Wait 30s and re-run this deployment cell.\")\n",
    "    return \"\"\n",
    "\n",
    "\n",
    "def run_aft(rel_yaml_path: str) -> str:\n",
    "    sync_env_exports()\n",
    "    update_progress(f\"Deploying '{rel_yaml_path}' via Apigee Templater (aft)...\")\n",
    "    cmd = [AFT_BIN, \"-i\", rel_yaml_path, \"--organization\", APIGEE_ORG, \"--environment\", APIGEE_ENVIRONMENT, \"--sa\", SERVICE_ACCOUNT]\n",
    "    proc = subprocess.run(cmd, cwd=str(REPO_DIR), capture_output=True, text=True, encoding=\"utf-8\")\n",
    "    cmd_str = f\"$ aft -i {rel_yaml_path} --organization {APIGEE_ORG} --environment {APIGEE_ENVIRONMENT} --sa {SERVICE_ACCOUNT}\"\n",
    "    out_txt = (proc.stdout or \"\").strip()\n",
    "    err_txt = (proc.stderr or \"\").strip()\n",
    "    if proc.returncode != 0:\n",
    "        fail_step(\n",
    "            f\"AFT Deployment Failed for '{rel_yaml_path}'\", f\"Exited with code {proc.returncode}.\",\n",
    "            \"Confirm Step 0 passed, verify APIGEE_ORG / APIGEE_ENVIRONMENT, and inspect technical logs below.\",\n",
    "            f\"{cmd_str}\\n{out_txt}\\n{err_txt}\".strip(),\n",
    "        )\n",
    "    return f\"{cmd_str}\\n{out_txt}\".strip()\n",
    "\n",
    "\n",
    "def fetch_approved_api_key(fallback_key: str = \"premium-app-key-123\") -> str:\n",
    "    status, data = apigee_request(\"GET\", \"apps\", params={\"expand\": \"true\"})\n",
    "    if status == 200:\n",
    "        creds = [c for app in data.get(\"app\", []) for c in app.get(\"credentials\", []) if c.get(\"status\") == \"approved\"]\n",
    "        for c in creds:\n",
    "            if c.get(\"consumerKey\") == fallback_key:\n",
    "                return fallback_key\n",
    "        if creds and creds[0].get(\"consumerKey\"):\n",
    "            return creds[0][\"consumerKey\"]\n",
    "    return fallback_key\n",
    "\n",
    "\n",
    "def sanitize_for_sdp_json(text: str) -> str:\n",
    "    \"\"\"Normalizes prompt text so Apigee SC-SensitiveDataProtection JSON substitution stays strictly valid.\"\"\"\n",
    "    cleaned = str(text or \"\").replace(\"\\\\\", \"/\").replace('\"', \"'\")\n",
    "    cleaned = re.sub(r\"[\\r\\n\\t]+\", \" — \", cleaned)\n",
    "    return re.sub(r\" {2,}\", \" \", cleaned).strip()\n",
    "\n",
    "\n",
    "def _format_quota_window(interval_raw: str, unit_raw: str) -> str:\n",
    "    iv = str(interval_raw or \"1\").strip() or \"1\"\n",
    "    un = str(unit_raw or \"minute\").strip().lower() or \"minute\"\n",
    "    if iv == \"1\":\n",
    "        return f\"1 {un.rstrip('s') if un != 's' else un}\"\n",
    "    plural = un if un.endswith(\"s\") else f\"{un}s\"\n",
    "    return f\"{iv} {plural}\"\n",
    "\n",
    "\n",
    "def _unauth_quota_info(key_status: str, key_disp: str, app_nm: str, prod_lbl: str, src: str, rule: str, sched: str) -> dict[str, Any]:\n",
    "    return {\n",
    "        \"key_status\": key_status, \"api_key_display\": key_disp, \"app_name\": app_nm, \"developer_email\": \"—\",\n",
    "        \"product_names\": [], \"product_label\": prod_lbl, \"source_label\": src, \"active_model_status\": \"unauthenticated\",\n",
    "        \"active_quota_limit\": None, \"active_quota_window\": \"\", \"active_model_rule\": rule, \"schedule_summary\": sched, \"llm_prompt_context\": \"\",\n",
    "    }\n",
    "\n",
    "\n",
    "def resolve_api_key_product_quotas(api_key: str, proxy_name: str, requested_model: str) -> dict[str, Any]:\n",
    "    \"\"\"Resolves the Developer App, API Product(s), allow-list status, and LLM token quotas for a given API key.\"\"\"\n",
    "    clean_key, raw_model = (api_key or \"\").strip(), (requested_model or \"\").strip()\n",
    "    alias_map = {\"gemini-flash-latest\": \"gemini-3.7-flash\", \"gemini-2.5-flash\": \"gemini-3.7-flash\"}\n",
    "    short_req = raw_model.split(\"/\")[-1]\n",
    "    mapped_short = alias_map.get(short_req, alias_map.get(raw_model, short_req))\n",
    "\n",
    "    if not clean_key:\n",
    "        return _unauth_quota_info(\n",
    "            \"missing\", \"(none — x-api-key header omitted)\", \"Unauthenticated Caller\",\n",
    "            \"None (x-api-key required)\", \"Gateway Pre-Auth Check\",\n",
    "            \"🚫 Blocked by VA-VerifyKey before model/quota evaluation (HTTP 401 expected)\",\n",
    "            \"Provide an approved API key (e.g. premium-app-key-123) to inspect API Product quotas.\",\n",
    "        )\n",
    "\n",
    "    matched_app, matched_email, cred_status, source_label = \"\", \"\", \"\", \"Live Apigee Management API\"\n",
    "    product_names: list[str] = []\n",
    "\n",
    "    apps_s, apps_d = apigee_request(\"GET\", \"apps\", params={\"expand\": \"true\"})\n",
    "    if apps_s == 200:\n",
    "        for app_obj in apps_d.get(\"app\", []):\n",
    "            for cred_obj in app_obj.get(\"credentials\", []):\n",
    "                if str(cred_obj.get(\"consumerKey\") or \"\").strip() == clean_key:\n",
    "                    c_st, a_st = str(cred_obj.get(\"status\") or \"approved\").lower(), str(app_obj.get(\"status\") or \"approved\").lower()\n",
    "                    cred_status = \"approved\" if (c_st == \"approved\" and a_st == \"approved\") else f\"{c_st} (app={a_st})\"\n",
    "                    matched_app = str(app_obj.get(\"name\") or app_obj.get(\"appId\") or \"Developer App\")\n",
    "                    matched_email = str(app_obj.get(\"developerEmail\") or \"\")\n",
    "                    for p_ref in cred_obj.get(\"apiProducts\", []):\n",
    "                        if isinstance(p_ref, dict) and str(p_ref.get(\"status\") or \"approved\").lower() == \"approved\":\n",
    "                            p_nm = str(p_ref.get(\"apiproduct\") or p_ref.get(\"name\") or \"\").strip()\n",
    "                            if p_nm:\n",
    "                                product_names.append(p_nm)\n",
    "                        elif isinstance(p_ref, str) and p_ref.strip():\n",
    "                            product_names.append(p_ref.strip())\n",
    "                    product_names.extend([str(p).strip() for p in cred_obj.get(\"products\", []) if str(p).strip()])\n",
    "                    break\n",
    "            if cred_status:\n",
    "                break\n",
    "\n",
    "    apps_dir = REPO_DIR / \"config\" / \"apps\"\n",
    "    if (not cred_status or not matched_email) and apps_dir.is_dir():\n",
    "        for app_yaml in sorted(apps_dir.glob(\"*.yaml\")):\n",
    "            try:\n",
    "                y_doc = yaml.safe_load(app_yaml.read_text(encoding=\"utf-8\"))\n",
    "            except (OSError, yaml.YAMLError):\n",
    "                y_doc = None\n",
    "            if not isinstance(y_doc, dict):\n",
    "                continue\n",
    "            for dev_e in (y_doc.get(\"developers\") if isinstance(y_doc.get(\"developers\"), list) else [y_doc]):\n",
    "                if not isinstance(dev_e, dict):\n",
    "                    continue\n",
    "                d_email = str(dev_e.get(\"email\") or dev_e.get(\"userName\") or \"\")\n",
    "                for y_app in (dev_e.get(\"apps\") or []):\n",
    "                    for y_cred in (y_app.get(\"credentials\") or [] if isinstance(y_app, dict) else []):\n",
    "                        if isinstance(y_cred, dict) and str(y_cred.get(\"consumerKey\") or y_cred.get(\"key\") or \"\").strip() == clean_key:\n",
    "                            matched_email = matched_email or d_email\n",
    "                            if not cred_status:\n",
    "                                source_label = \"Repository Config YAML\"\n",
    "                                c_st, a_st = str(y_cred.get(\"status\") or \"approved\").lower(), str(y_app.get(\"status\") or \"approved\").lower()\n",
    "                                cred_status = \"approved\" if (c_st == \"approved\" and a_st == \"approved\") else c_st\n",
    "                                matched_app = str(y_app.get(\"displayName\") or y_app.get(\"name\") or \"Developer App\")\n",
    "                                product_names.extend([str(x).strip() for x in (y_cred.get(\"products\") or y_app.get(\"products\") or []) if str(x).strip()])\n",
    "                            break\n",
    "\n",
    "    product_names = list(dict.fromkeys(product_names))\n",
    "    if not cred_status:\n",
    "        return _unauth_quota_info(\n",
    "            \"invalid\", clean_key, \"Unrecognized Key\", \"None (Key not registered in Apigee)\", source_label,\n",
    "            \"🚫 Invalid API Key — rejected by VA-VerifyKey (HTTP 401 expected)\",\n",
    "            \"No API Product quotas apply because this API key is not recognized.\",\n",
    "        )\n",
    "    if cred_status != \"approved\":\n",
    "        return _unauth_quota_info(\n",
    "            \"revoked\", clean_key, matched_app, \", \".join(product_names) or \"None\", source_label,\n",
    "            f\"🚫 Credential status is '{cred_status}' (HTTP 401/403 expected)\", \"Credential is not approved.\",\n",
    "        )\n",
    "\n",
    "    product_labels, proxy_rules, prod_level_quotas = [], [], []\n",
    "    for prod_nm in product_names:\n",
    "        p_s, p_data = apigee_request(\"GET\", f\"apiproducts/{prod_nm}\")\n",
    "        if p_s != 200 or not isinstance(p_data, dict) or not p_data:\n",
    "            p_data = {}\n",
    "            prod_dir = REPO_DIR / \"config\" / \"products\"\n",
    "            for cand in [prod_dir / f\"{prod_nm}.yaml\", *(sorted(prod_dir.glob(\"*.yaml\")) if prod_dir.is_dir() else [])]:\n",
    "                if cand.is_file():\n",
    "                    try:\n",
    "                        cand_doc = yaml.safe_load(cand.read_text(encoding=\"utf-8\"))\n",
    "                    except (OSError, yaml.YAMLError):\n",
    "                        cand_doc = None\n",
    "                    if isinstance(cand_doc, dict) and (cand.stem == prod_nm or str(cand_doc.get(\"name\") or \"\") == prod_nm):\n",
    "                        p_data = cand_doc\n",
    "                        source_label = \"Apigee App + Product YAML\" if source_label == \"Live Apigee Management API\" else source_label\n",
    "                        break\n",
    "\n",
    "        disp_nm = str(p_data.get(\"displayName\") or prod_nm).strip()\n",
    "        product_labels.append(f\"{disp_nm} ({prod_nm})\" if disp_nm and disp_nm != prod_nm else prod_nm)\n",
    "        p_llm_q, p_rest_q = str(p_data.get(\"llmQuota\") or \"\").strip(), str(p_data.get(\"quota\") or \"\").strip()\n",
    "        if p_llm_q.isdigit():\n",
    "            prod_level_quotas.append(f\"Product LLM Quota: {int(p_llm_q):,} tokens / {_format_quota_window(str(p_data.get('llmQuotaInterval') or '1'), str(p_data.get('llmQuotaTimeUnit') or 'hour'))}\")\n",
    "        if p_rest_q.isdigit():\n",
    "            prod_level_quotas.append(f\"REST Call Quota: {int(p_rest_q):,} requests / {_format_quota_window(str(p_data.get('quotaInterval') or '1'), str(p_data.get('quotaTimeUnit') or 'minute'))}\")\n",
    "\n",
    "        op_group = p_data.get(\"llmOperationGroup\")\n",
    "        raw_cfgs = op_group[\"operationConfigs\"] if (isinstance(op_group, dict) and isinstance(op_group.get(\"operationConfigs\"), list)) else (p_data.get(\"llmOperations\") if isinstance(p_data.get(\"llmOperations\"), list) else [])\n",
    "        for cfg in raw_cfgs:\n",
    "            if not isinstance(cfg, dict):\n",
    "                continue\n",
    "            api_src = str(cfg.get(\"apiSource\") or \"\").strip()\n",
    "            applies = (not proxy_name) or (not api_src) or (api_src in (proxy_name, \"*\"))\n",
    "            tq = cfg.get(\"llmTokenQuota\") or cfg.get(\"quota\") or {}\n",
    "            lim_str = str(tq.get(\"limit\") or \"\").strip() if isinstance(tq, dict) else \"\"\n",
    "            win_txt = _format_quota_window(str(tq.get(\"interval\") or \"1\") if isinstance(tq, dict) else \"1\", str(tq.get(\"timeUnit\") or tq.get(\"time_unit\") or \"minute\") if isinstance(tq, dict) else \"minute\")\n",
    "            for op in (cfg.get(\"llmOperations\") or cfg.get(\"operations\") or ([cfg] if cfg.get(\"model\") else [])):\n",
    "                m_val = str(op.get(\"model\") or \"\").strip() if isinstance(op, dict) else \"\"\n",
    "                if m_val and applies:\n",
    "                    proxy_rules.append({\"product\": prod_nm, \"model\": m_val, \"limit\": (int(lim_str) if lim_str.isdigit() else None), \"window\": win_txt})\n",
    "\n",
    "    dedup_rules = list({r[\"model\"]: r for r in reversed(proxy_rules)}.values())[::-1]\n",
    "    schedule_ui_parts = [f\"{r['model']}: {r['limit']:,} tokens / {r['window']}\" if r[\"limit\"] is not None else f\"{r['model']}: Authorized (Unlimited token quota)\" for r in dedup_rules] + prod_level_quotas\n",
    "    schedule_llm_parts = [f\"{r['model']} = {r['limit']:,} tokens / {r['window']}\" if r[\"limit\"] is not None else f\"{r['model']} = Authorized (unlimited token quota)\" for r in dedup_rules] + prod_level_quotas\n",
    "    product_label_str = \", \".join(product_labels) or \"None\"\n",
    "    schedule_summary = \" • \".join(schedule_ui_parts) or \"No LLM model operations configured for this proxy\"\n",
    "\n",
    "    matched_rule = next((r for r in dedup_rules if r[\"model\"] in (\"*\", raw_model, mapped_short) or r[\"model\"].split(\"/\")[-1] in (\"*\", mapped_short)), None)\n",
    "    if short_req == \"smart-router\":\n",
    "        flash38 = next((r for r in dedup_rules if r[\"model\"].split(\"/\")[-1] == \"gemini-3.8-flash\"), None)\n",
    "        active_status, active_limit, active_window = \"smart_router\", (flash38[\"limit\"] if flash38 else None), (flash38[\"window\"] if flash38 else \"\")\n",
    "        active_rule_txt = \"✅ Dynamic Smart-Router — enforces per-model quota of whichever authorized model handles the prompt\"\n",
    "        active_llm_txt = \"Dynamic Smart-Router (applies target model quota from schedule)\"\n",
    "    elif matched_rule is not None and matched_rule[\"limit\"] is not None:\n",
    "        active_status, active_limit, active_window = \"allowed_with_quota\", matched_rule[\"limit\"], matched_rule[\"window\"]\n",
    "        active_rule_txt = f\"✅ Authorized ({matched_rule['model']}) — Quota: {active_limit:,} tokens / {active_window}\"\n",
    "        active_llm_txt = f\"{active_limit:,} tokens per {active_window}\"\n",
    "    elif matched_rule is not None:\n",
    "        active_status, active_limit, active_window = \"allowed_unlimited\", None, \"unlimited\"\n",
    "        active_rule_txt = f\"✅ Authorized ({matched_rule['model']}) — Unlimited LLM Token Quota\"\n",
    "        active_llm_txt = \"Authorized (unlimited token quota)\"\n",
    "    else:\n",
    "        active_status, active_limit, active_window = \"model_not_allowed\", 0, \"\"\n",
    "        alias_hint = f\" (mapped from {raw_model} to {mapped_short})\" if mapped_short != short_req else \"\"\n",
    "        active_rule_txt = f\"🚫 Not in API Product Allow-List{alias_hint} — HTTP 403 'Model not allowed.' expected\"\n",
    "        active_llm_txt = \"Not authorized in API Product\"\n",
    "\n",
    "    llm_ctx = \"\"\n",
    "    if active_status in (\"allowed_with_quota\", \"allowed_unlimited\", \"smart_router\"):\n",
    "        sched_semis = \"; \".join(schedule_llm_parts) or \"None\"\n",
    "        llm_ctx = sanitize_for_sdp_json(\n",
    "            f\"[Gateway API Product Quota Metadata for Active Key — Consumer App: {matched_app} | API Product: {product_label_str} | \"\n",
    "            f\"Gateway Proxy: {proxy_name} | Active Model ({raw_model}) Quota: {active_llm_txt} | \"\n",
    "            f\"Full API Product LLM Token Quota Schedule: {sched_semis}] \"\n",
    "            \"Response Requirement: First provide a concise answer to the prompt above, and then include a section \"\n",
    "            \"titled 'API Product Quotas for Active Key' reporting the Consumer App, API Product name, active model token quota, \"\n",
    "            \"and complete per-model token quota schedule configured for this API key.\"\n",
    "        )\n",
    "\n",
    "    return {\n",
    "        \"key_status\": \"approved\", \"api_key_display\": clean_key, \"app_name\": matched_app,\n",
    "        \"developer_email\": matched_email or \"configured-developer\", \"product_names\": product_names,\n",
    "        \"product_label\": product_label_str, \"source_label\": source_label, \"active_model_status\": active_status,\n",
    "        \"active_quota_limit\": active_limit, \"active_quota_window\": active_window,\n",
    "        \"active_model_rule\": active_rule_txt, \"schedule_summary\": schedule_summary, \"llm_prompt_context\": llm_ctx,\n",
    "    }\n",
