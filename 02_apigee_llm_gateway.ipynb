    "def build_quota_test_workload(lead_instruction: str, target_tokens: int) -> str:\n",
    "    \"\"\"Builds a realistic, SDP/Model-Armor-safe enterprise FinOps telemetry dossier calibrated to ~target_tokens.\"\"\"\n",
    "    # ~4.45 characters of natural business English prose corresponds to ~1 LLM token on Gemini & Claude tokenizers\n",
    "    target_chars = max(600, int(target_tokens * 4.45))\n",
    "    header = sanitize_for_sdp_json(lead_instruction) + \" — Enterprise AI Gateway Regional Telemetry Digest: \"\n",
    "    chunks: list[str] = [header]\n",
    "    cur_len = len(header)\n",
    "    idx = 0\n",
    "    phases = (\"Window-Alpha\", \"Window-Bravo\", \"Window-Charlie\", \"Window-Delta\", \"Window-Echo\", \"Window-Foxtrot\")\n",
    "    priorities = (\"routine-tier\", \"priority-tier\", \"batch-analytics-tier\", \"interactive-slo-tier\")\n",
    "    while cur_len < target_chars:\n",
    "        seg = QUOTA_TELEMETRY_SEGMENTS[idx % len(QUOTA_TELEMETRY_SEGMENTS)]\n",
    "        ph = phases[(idx // len(QUOTA_TELEMETRY_SEGMENTS)) % len(phases)]\n",
    "        pr = priorities[idx % len(priorities)]\n",
    "        entry = f\"[{ph} | {pr}] {seg} \"\n",
    "        chunks.append(entry)\n",
    "        cur_len += len(entry)\n",
    "        idx += 1\n",
    "    return sanitize_for_sdp_json(\"\".join(chunks))\n",
    "\n",
    "\n",
    "def upsert_model_armor_template(template_id: str, location: str, confidence_level: str, role_label: str) -> tuple[str, str]:\n",
    "    \"\"\"Creates or updates a regional Google Cloud Model Armor v1 template.\"\"\"\n",
    "    clean_id = template_id.strip().split(\"/\")[-1].strip()\n",
    "    if not re.fullmatch(r\"[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}\", clean_id):\n",
    "        fail_step(\n",
    "            f\"Invalid {role_label} Template ID\",\n",
    "            f\"'{template_id}' is not a valid Model Armor template ID.\",\n",
    "            \"Use 1–63 letters, digits, hyphens, or underscores (cannot start with a hyphen).\",\n",
    "        )\n",
    "    loc = location.strip() or REGION\n",
    "    base_url = f\"https://modelarmor.{loc}.rep.googleapis.com/v1/projects/{PROJECT_ID}/locations/{loc}/templates\"\n",
    "    q_headers = {\"x-goog-user-project\": PROJECT_ID}\n",
    "    rai_filters = [\n",
    "        {\"filterType\": ft, \"confidenceLevel\": confidence_level}\n",
    "        for ft in (\"HATE_SPEECH\", \"HARASSMENT\", \"SEXUALLY_EXPLICIT\", \"DANGEROUS\")\n",
    "    ]\n",
    "    meta_cfg = {\n",
    "        \"enforcementType\": \"INSPECT_AND_BLOCK\",\n",
    "        \"ignorePartialInvocationFailures\": True,\n",
    "        \"logSanitizeOperations\": True,\n",
    "    }\n",
    "    full_body: dict[str, Any] = {\n",
    "        \"filterConfig\": {\n",
    "            \"raiSettings\": {\"raiFilters\": rai_filters},\n",
    "            \"piAndJailbreakFilterSettings\": {\"filterEnforcement\": \"ENABLED\", \"confidenceLevel\": confidence_level},\n",
    "            \"maliciousUriFilterSettings\": {\"filterEnforcement\": \"ENABLED\"},\n",
    "        },\n",
    "        \"templateMetadata\": meta_cfg,\n",
    "    }\n",
    "    core_body: dict[str, Any] = {\n",
    "        \"filterConfig\": {\n",
    "            \"raiSettings\": {\"raiFilters\": rai_filters},\n",
    "            \"piAndJailbreakFilterSettings\": {\"filterEnforcement\": \"ENABLED\", \"confidenceLevel\": confidence_level},\n",
    "        },\n",
    "        \"templateMetadata\": meta_cfg,\n",
    "    }\n",
    "\n",
    "    subprocess.run(\n",
    "        [\"gcloud\", \"config\", \"set\", \"api_endpoint_overrides/modelarmor\", f\"https://modelarmor.{loc}.rep.googleapis.com/\", \"--quiet\"],\n",
    "        capture_output=True, text=True, check=False,\n",
    "    )\n",
    "    status, data = gcp_json_request(\"POST\", base_url, json_body=full_body, params={\"template_id\": clean_id}, extra_headers=q_headers)\n",
    "    if status == 400:\n",
    "        status, data = gcp_json_request(\"POST\", base_url, json_body=core_body, params={\"template_id\": clean_id}, extra_headers=q_headers)\n",
    "    if status in (200, 201):\n",
    "        res_name = str(data.get(\"name\") or f\"projects/{PROJECT_ID}/locations/{loc}/templates/{clean_id}\")\n",
    "        return \"Created\", res_name\n",
    "\n",
    "    if status == 409:\n",
    "        item_url = f\"{base_url}/{clean_id}\"\n",
    "        u_s, u_d = gcp_json_request(\"PATCH\", item_url, json_body=full_body, params={\"updateMask\": \"filterConfig,templateMetadata\"}, extra_headers=q_headers)\n",
    "        if u_s == 400:\n",
    "            u_s, u_d = gcp_json_request(\"PATCH\", item_url, json_body=core_body, params={\"updateMask\": \"filterConfig,templateMetadata\"}, extra_headers=q_headers)\n",
    "        if u_s == 200:\n",
    "            res_name = str(u_d.get(\"name\") or f\"projects/{PROJECT_ID}/locations/{loc}/templates/{clean_id}\")\n",
    "            return \"Updated Existing\", res_name\n",
    "        g_s, g_d = gcp_json_request(\"GET\", item_url, extra_headers=q_headers)\n",
    "        if g_s == 200:\n",
    "            res_name = str(g_d.get(\"name\") or f\"projects/{PROJECT_ID}/locations/{loc}/templates/{clean_id}\")\n",
    "            return \"Verified Existing\", res_name\n",
    "\n",
    "    fail_step(\n",
    "        f\"Could Not Create {role_label} Model Armor Template '{clean_id}'\",\n",
    "        f\"Model Armor API in '{loc}' returned HTTP {status}.\",\n",
    "        f\"Verify that '{loc}' is a supported Model Armor region (e.g. europe-west1, europe-west4, us-central1), \"\n",
    "        \"ensure modelarmor.googleapis.com is enabled, and confirm your account has Model Armor Admin (roles/modelarmor.admin).\",\n",
    "        json.dumps(data, indent=2),\n",
    "    )\n",
    "    return \"\", \"\"\n",
    "\n",
    "\n",
    "SDP_DEFAULT_INFOTYPES = (\n",
    "    \"PERSON_NAME\",\n",
