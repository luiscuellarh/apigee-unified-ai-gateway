   "source": [
    "#@title 6.2 Executive AI Governance & Business Analytics Dashboard (Apigee API)\n",
    "TIME_RANGE_WINDOW = \"Last 24 Hours\"  #@param [\"Last 1 Hour\", \"Last 6 Hours\", \"Last 24 Hours\", \"Last 7 Days\", \"Last 14 Days\", \"Last 30 Days\"]\n",
    "LATENCY_SLO_TARGET_MS = 1200  #@param {type:\"integer\"}\n",
    "PRODUCT_QUOTA_LIMIT_TOKENS = 10000  #@param {type:\"integer\"}\n",
    "INCLUDE_REFERENCE_TELEMETRY_IF_INGESTING = True  #@param {type:\"boolean\"}\n",
    "\n",
    "hours = {\"Last 1 Hour\": 1, \"Last 6 Hours\": 6, \"Last 24 Hours\": 24, \"Last 7 Days\": 168, \"Last 14 Days\": 336, \"Last 30 Days\": 720}.get(TIME_RANGE_WINDOW, 24)\n",
    "now_utc = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(minutes=5)\n",
    "start_str = (now_utc - datetime.timedelta(hours=hours)).strftime(\"%m/%d/%Y %H:%M\")\n",
    "end_str = now_utc.strftime(\"%m/%d/%Y %H:%M\")\n",
    "time_range_str = f\"{start_str}~{end_str}\"\n",
    "\n",
    "\n",
    "def query_apigee_stats(dims: list[str], metrics: list[str], unit: str = \"day\") -> list[dict[str, Any]]:\n",
    "    dims_csv = \",\".join(dims)\n",
    "    s, payload = apigee_request(\"GET\", f\"environments/{APIGEE_ENVIRONMENT}/stats/{dims_csv}\", params={\"select\": \",\".join(metrics), \"timeRange\": time_range_str, \"timeUnit\": unit})\n",
    "    envs = payload.get(\"environments\", []) if s == 200 else []\n",
    "    rows: list[dict[str, Any]] = []\n",
    "    for d_entry in (envs[0].get(\"dimensions\", []) if envs else []):\n",
    "        parts = [p.strip() for p in d_entry.get(\"name\", \"\").split(\",\")]\n",
    "        row: dict[str, Any] = {col: (parts[i] if i < len(parts) and parts[i] else \"(not set)\") for i, col in enumerate(dims)}\n",
    "        for m in d_entry.get(\"metrics\", []):\n",
    "            nums: list[float] = []\n",
    "            for v in m.get(\"values\", []):\n",
    "                try:\n",
    "                    nums.append(float(v.get(\"value\", 0.0) if isinstance(v, dict) else v))\n",
    "                except (TypeError, ValueError):\n",
    "                    pass\n",
    "            nz = [x for x in nums if x > 0]\n",
    "            row[m.get(\"name\", \"\")] = (sum(nz) / len(nz) if nz else 0.0) if m.get(\"name\", \"\").startswith(\"avg(\") else sum(nums)\n",
    "        rows.append(row)\n",
    "    return rows\n",
    "\n",
    "\n",
    "start_progress(\"Step 6.2 — Building Executive FinOps & Governance Dashboard\", f\"Step 1/3: Querying Apigee Analytics API (/stats) for {TIME_RANGE_WINDOW}...\")\n",
    "cost_raw = query_apigee_stats([\"dc_ai_model\", \"developer_email\"], [\"sum(dc_ai_total_cost)\", \"sum(dc_ai_request_cost)\", \"sum(dc_ai_response_cost)\", \"sum(message_count)\"], \"day\")\n",
    "update_progress(\"Step 1/3: Querying latency, token throughput & policy status metrics...\")\n",
    "lat_raw = query_apigee_stats([\"apiproxy\", \"dc_ai_model\", \"dc_ai_response_type\"], [\"sum(dc_ai_total_token_count)\", \"avg(dc_ai_time_first_token)\", \"sum(message_count)\", \"avg(total_response_time)\"], \"hour\")\n",
    "tok_raw = query_apigee_stats([\"dc_ai_model\", \"developer_email\"], [\"sum(dc_ai_total_token_count)\", \"sum(dc_ai_prompt_token_count)\", \"sum(dc_ai_response_token_count)\", \"sum(message_count)\"], \"day\")\n",
    "gw_raw = query_apigee_stats([\"apiproxy\", \"response_status_code\"], [\"sum(message_count)\"], \"hour\")\n",
    "\n",
    "_lbl = lambda v, fb: fb if not v or v.lower() in (\"(not set)\", \"unknown\", \"null\") else v\n",
    "live_tok = sum(float(r.get(\"sum(dc_ai_total_token_count)\", 0.0)) for r in tok_raw)\n",
    "live_cost = sum(float(r.get(\"sum(dc_ai_total_cost)\", 0.0)) for r in cost_raw)\n",
    "using_ref = False\n",
    "\n",
    "if live_tok > 0 or live_cost > 0:\n",
    "    cost_rows = [\n",
    "        {\"model\": _lbl(r.get(\"dc_ai_model\", \"\"), \"Blocked Pre-Model\"), \"user\": _lbl(r.get(\"developer_email\", \"\"), \"anonymous (Areas 1–3)\"),\n",
    "         \"request_cost\": float(r.get(\"sum(dc_ai_request_cost)\", 0.0)), \"response_cost\": float(r.get(\"sum(dc_ai_response_cost)\", 0.0)),\n",
    "         \"total_cost\": float(r.get(\"sum(dc_ai_total_cost)\", 0.0)) or (float(r.get(\"sum(dc_ai_request_cost)\", 0.0)) + float(r.get(\"sum(dc_ai_response_cost)\", 0.0))),\n",
    "         \"messages\": max(int(round(float(r.get(\"sum(message_count)\", 0.0)))), 1)}\n",
    "        for r in cost_raw if float(r.get(\"sum(dc_ai_total_cost)\", 0.0)) > 0 or r.get(\"dc_ai_model\", \"(not set)\") != \"(not set)\"\n",
    "    ]\n",
    "    latency_rows = [\n",
    "        {\"proxy\": r.get(\"apiproxy\", \"llm-gateway\"), \"model\": _lbl(r.get(\"dc_ai_model\", \"\"), \"Blocked Pre-Model\"),\n",
    "         \"response_type\": _lbl(r.get(\"dc_ai_response_type\", \"\"), \"non-streaming\"), \"total_tokens\": int(round(float(r.get(\"sum(dc_ai_total_token_count)\", 0.0)))),\n",
    "         \"ttft_ms\": float(r.get(\"avg(dc_ai_time_first_token)\", 0.0)) or float(r.get(\"avg(total_response_time)\", 0.0)),\n",
    "         \"messages\": int(round(float(r.get(\"sum(message_count)\", 0.0))))}\n",
    "        for r in lat_raw if int(round(float(r.get(\"sum(message_count)\", 0.0)))) > 0\n",
    "    ]\n",
    "    token_rows = [\n",
    "        {\"model\": _lbl(r.get(\"dc_ai_model\", \"\"), \"Blocked Pre-Model\"), \"user\": _lbl(r.get(\"developer_email\", \"\"), \"anonymous (Areas 1–3)\"),\n",
    "         \"prompt_tokens\": int(round(float(r.get(\"sum(dc_ai_prompt_token_count)\", 0.0)))), \"response_tokens\": int(round(float(r.get(\"sum(dc_ai_response_token_count)\", 0.0)))),\n",
    "         \"total_tokens\": int(round(float(r.get(\"sum(dc_ai_total_token_count)\", 0.0)))) or (int(round(float(r.get(\"sum(dc_ai_prompt_token_count)\", 0.0)))) + int(round(float(r.get(\"sum(dc_ai_response_token_count)\", 0.0))))),\n",
    "         \"messages\": max(int(round(float(r.get(\"sum(message_count)\", 0.0)))), 1)}\n",
    "        for r in tok_raw if int(round(float(r.get(\"sum(dc_ai_total_token_count)\", 0.0)))) > 0 or r.get(\"dc_ai_model\", \"(not set)\") != \"(not set)\"\n",
    "    ]\n",
    "elif INCLUDE_REFERENCE_TELEMETRY_IF_INGESTING:\n",
    "    using_ref = True\n",
    "    cost_rows = [\n",
    "        {\"model\": \"gemini-3.5-flash-lite\", \"user\": \"user@example.com\", \"request_cost\": 0.0084, \"response_cost\": 0.0342, \"total_cost\": 0.0426, \"messages\": 28},\n",
    "        {\"model\": VERTEX_MODEL, \"user\": \"user@example.com\", \"request_cost\": 0.0062, \"response_cost\": 0.0249, \"total_cost\": 0.0311, \"messages\": 19},\n",
    "        {\"model\": \"claude-sonnet-5\", \"user\": \"user@example.com\", \"request_cost\": 0.0195, \"response_cost\": 0.0680, \"total_cost\": 0.0875, \"messages\": 11},\n",
    "        {\"model\": \"gemini-3.5-flash-lite\", \"user\": \"anonymous (Areas 1–3)\", \"request_cost\": 0.0031, \"response_cost\": 0.0118, \"total_cost\": 0.0149, \"messages\": 14},\n",
    "    ]\n",
    "    latency_rows = [\n",
    "        {\"proxy\": \"llm-gateway-completions-auth-ma-sdp-semantic\", \"model\": \"gemini-3.5-flash-lite\", \"response_type\": \"non-streaming\", \"total_tokens\": 11420, \"ttft_ms\": 310.0, \"messages\": 18},\n",
    "        {\"proxy\": \"llm-gateway-completions-auth-ma-sdp\", \"model\": \"gemini-3.5-flash-lite\", \"response_type\": \"non-streaming\", \"total_tokens\": 14850, \"ttft_ms\": 690.0, \"messages\": 16},\n",
    "        {\"proxy\": \"llm-gateway-completions-auth-ma-sdp\", \"model\": VERTEX_MODEL, \"response_type\": \"streaming\", \"total_tokens\": 10370, \"ttft_ms\": 540.0, \"messages\": 13},\n",
    "        {\"proxy\": \"llm-gateway-completions-auth-ma-sdp\", \"model\": \"claude-sonnet-5\", \"response_type\": \"non-streaming\", \"total_tokens\": 8920, \"ttft_ms\": 1140.0, \"messages\": 11},\n",
    "    ]\n",
    "    token_rows = [\n",
    "        {\"model\": \"gemini-3.5-flash-lite\", \"user\": \"user@example.com\", \"prompt_tokens\": 8400, \"response_tokens\": 11400, \"total_tokens\": 19800, \"messages\": 28},\n",
    "        {\"model\": VERTEX_MODEL, \"user\": \"user@example.com\", \"prompt_tokens\": 6200, \"response_tokens\": 8300, \"total_tokens\": 14500, \"messages\": 19},\n",
    "        {\"model\": \"claude-sonnet-5\", \"user\": \"user@example.com\", \"prompt_tokens\": 3900, \"response_tokens\": 5020, \"total_tokens\": 8920, \"messages\": 11},\n",
    "        {\"model\": \"gemini-3.5-flash-lite\", \"user\": \"anonymous (Areas 1–3)\", \"prompt_tokens\": 3100, \"response_tokens\": 3930, \"total_tokens\": 7030, \"messages\": 14},\n",
    "    ]\n",
    "else:\n",
    "    using_ref, cost_rows, latency_rows, token_rows = True, [], [], []\n",
    "\n",
    "cost_rows.sort(key=lambda x: x[\"total_cost\"], reverse=True)\n",
    "latency_rows.sort(key=lambda x: x[\"messages\"], reverse=True)\n",
    "token_rows.sort(key=lambda x: x[\"total_tokens\"], reverse=True)\n",
    "\n",
    "status_counts = {\"2xx Allowed\": 0, \"400 Model Armor\": 0, \"401/403 Auth & Model\": 0, \"429 Token Quota\": 0}\n",
    "for gr in gw_raw:\n",
    "    c_str, cnt = str(gr.get(\"response_status_code\", \"200\")).strip(), int(round(float(gr.get(\"sum(message_count)\", 0.0))))\n",
    "    if c_str.startswith(\"2\"):\n",
    "        status_counts[\"2xx Allowed\"] += cnt\n",
    "    elif c_str == \"400\":\n",
    "        status_counts[\"400 Model Armor\"] += cnt\n",
    "    elif c_str in (\"401\", \"403\"):\n",
    "        status_counts[\"401/403 Auth & Model\"] += cnt\n",
    "    elif c_str == \"429\":\n",
    "        status_counts[\"429 Token Quota\"] += cnt\n",
    "if sum(status_counts.values()) == 0 and INCLUDE_REFERENCE_TELEMETRY_IF_INGESTING:\n",
    "    status_counts = {\"2xx Allowed\": max(sum(r[\"messages\"] for r in latency_rows), 58), \"400 Model Armor\": 6, \"401/403 Auth & Model\": 5, \"429 Token Quota\": 4}\n",
    "\n",
    "tot_spend, tot_in_cost, tot_out_cost = sum(r[\"total_cost\"] for r in cost_rows), sum(r[\"request_cost\"] for r in cost_rows), sum(r[\"response_cost\"] for r in cost_rows)\n",
    "tot_tokens, tot_in_tok, tot_out_tok = sum(r[\"total_tokens\"] for r in token_rows), sum(r[\"prompt_tokens\"] for r in token_rows), sum(r[\"response_tokens\"] for r in token_rows)\n",
    "tot_reqs, lat_msgs = max(sum(r[\"messages\"] for r in latency_rows), sum(r[\"messages\"] for r in token_rows), 1), max(sum(r[\"messages\"] for r in latency_rows), 1)\n",
    "avg_ttft = sum(r[\"ttft_ms\"] * r[\"messages\"] for r in latency_rows) / lat_msgs if latency_rows else 0.0\n",
    "slo_pct = (sum(r[\"messages\"] for r in latency_rows if r[\"ttft_ms\"] <= LATENCY_SLO_TARGET_MS) / lat_msgs) * 100.0 if latency_rows else 100.0\n",
    "cnt_armor, cnt_auth, cnt_quota = status_counts[\"400 Model Armor\"], status_counts[\"401/403 Auth & Model\"], status_counts[\"429 Token Quota\"]\n",
    "blocked = cnt_armor + cnt_auth + cnt_quota\n",
    "block_pct = (blocked / max(sum(status_counts.values()), 1)) * 100.0\n",
    "\n",
    "update_progress(\"Step 2/3: Rendering 4-panel Executive FinOps, Latency SLO & Governance charts...\")\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 8.5), dpi=125)\n",
    "fig.patch.set_facecolor(\"#ffffff\")\n",
    "plt.subplots_adjust(hspace=0.38, wspace=0.28)\n",
    "\n",
    "\n",
    "def _style_ax(ax: Any, title: str, grid_axis: str = \"y\") -> None:\n",
    "    ax.set_title(title, fontsize=10.5, fontweight=\"bold\", color=\"#174ea6\")\n",
    "    ax.grid(axis=grid_axis, linestyle=\"--\", alpha=0.4)\n",
    "    ax.spines[\"top\"].set_visible(False)\n",
    "    ax.spines[\"right\"].set_visible(False)\n",
    "\n",
    "\n",
    "ax1, ax2, ax3, ax4 = axes[0, 0], axes[0, 1], axes[1, 0], axes[1, 1]\n",
    "if cost_rows:\n",
    "    lbl1 = [r[\"model\"] + \"\\n(\" + r[\"user\"].split(\" \")[0] + \")\" for r in cost_rows[:6]][::-1]\n",
    "    rc1, sc1 = [r[\"request_cost\"] for r in cost_rows[:6]][::-1], [r[\"response_cost\"] for r in cost_rows[:6]][::-1]\n",
    "    ax1.barh(range(len(lbl1)), rc1, color=\"#1a73e8\", label=\"Prompt Cost\", height=0.55)\n",
    "    ax1.barh(range(len(lbl1)), sc1, left=rc1, color=\"#34a853\", label=\"Output Cost\", height=0.55)\n",
    "    ax1.set_yticks(range(len(lbl1)))\n",
    "    ax1.set_yticklabels(lbl1, fontsize=8.5)\n",
    "    ax1.legend(loc=\"lower right\", fontsize=8)\n",
    "_style_ax(ax1, \"Report 1: AI Token Cost by Model & User ($)\", \"x\")\n",
    "\n",
    "if latency_rows:\n",
    "    lbl2 = [r[\"model\"][:15] + \"\\n[\" + r[\"proxy\"].replace(\"llm-gateway-completions-\", \"\")[:13] + \"]\" for r in latency_rows[:6]]\n",
    "    ttfts = [r[\"ttft_ms\"] for r in latency_rows[:6]]\n",
    "    cols2 = [\"#137333\" if v <= LATENCY_SLO_TARGET_MS * 0.7 else (\"#f9ab00\" if v <= LATENCY_SLO_TARGET_MS else \"#d93025\") for v in ttfts]\n",
    "    ax2.bar(range(len(lbl2)), ttfts, color=cols2, width=0.52)\n",
    "    ax2.axhline(LATENCY_SLO_TARGET_MS, color=\"#d93025\", linestyle=\"--\", linewidth=1.4, label=f\"SLO ({LATENCY_SLO_TARGET_MS} ms)\")\n",
    "    ax2.set_xticks(range(len(lbl2)))\n",
    "    ax2.set_xticklabels(lbl2, fontsize=8, rotation=15, ha=\"right\")\n",
    "    ax2.legend(loc=\"upper right\", fontsize=8)\n",
    "_style_ax(ax2, \"Report 2: Avg Time to First Token (TTFT ms)\", \"y\")\n",
    "\n",
    "if token_rows:\n",
    "    lbl3 = [r[\"model\"][:15] + \"\\n(\" + r[\"user\"].split(\" \")[0] + \")\" for r in token_rows[:6]]\n",
    "    pt3, ct3 = [r[\"prompt_tokens\"] for r in token_rows[:6]], [r[\"response_tokens\"] for r in token_rows[:6]]\n",
    "    ax3.bar(range(len(lbl3)), pt3, color=\"#4285f4\", label=\"Prompt Tokens\", width=0.52)\n",
    "    ax3.bar(range(len(lbl3)), ct3, bottom=pt3, color=\"#fbbc04\", label=\"Output Tokens\", width=0.52)\n",
    "    ax3.axhline(PRODUCT_QUOTA_LIMIT_TOKENS, color=\"#c5221f\", linestyle=\":\", linewidth=1.4, label=f\"Quota ({PRODUCT_QUOTA_LIMIT_TOKENS:,})\")\n",
    "    ax3.set_xticks(range(len(lbl3)))\n",
    "    ax3.set_xticklabels(lbl3, fontsize=8, rotation=15, ha=\"right\")\n",
    "    ax3.legend(loc=\"upper right\", fontsize=7.5)\n",
    "_style_ax(ax3, \"Report 3: Token Volume vs Product Quota\", \"y\")\n",
    "\n",
    "g_items = [(k, v) for k, v in status_counts.items() if v > 0]\n",
    "g_cols = {\"2xx Allowed\": \"#1e8e3e\", \"400 Model Armor\": \"#d93025\", \"401/403 Auth & Model\": \"#f9ab00\", \"429 Token Quota\": \"#9334e6\"}\n",
    "if g_items:\n",
    "    wedges, _, autotexts = ax4.pie([v for _, v in g_items], autopct=\"%1.1f%%\", startangle=140, colors=[g_cols[k] for k, _ in g_items], pctdistance=0.75, wedgeprops={\"width\": 0.45, \"edgecolor\": \"white\", \"linewidth\": 2})\n",
    "    for at in autotexts:\n",
    "        at.set_fontsize(8.5)\n",
    "        at.set_fontweight(\"bold\")\n",
    "        at.set_color(\"#ffffff\")\n",
    "    ax4.legend(wedges, [f\"{k} ({v})\" for k, v in g_items], loc=\"lower center\", bbox_to_anchor=(0.5, -0.2), fontsize=8, ncol=2)\n",
    "ax4.set_title(\"Gateway Policy Enforcement Mix\", fontsize=10.5, fontweight=\"bold\", color=\"#174ea6\")\n",
    "\n",
    "buf = io.BytesIO()\n",
    "plt.savefig(buf, format=\"png\", bbox_inches=\"tight\", facecolor=\"#ffffff\")\n",
    "plt.close(fig)\n",
    "chart_b64 = base64.b64encode(buf.getvalue()).decode(\"utf-8\")\n",
    "\n",
    "update_progress(\"Step 3/3: Assembling Executive HTML Dashboard...\")\n",
    "src_badge = \"<span class='agw-badge agw-pass'>🟢 LIVE APIGEE ANALYTICS DATA</span>\" if not using_ref else \"<span class='agw-badge agw-cache'>📊 APIGEE REPORTS + REFERENCE TELEMETRY (Ingesting)</span>\"\n",
    "console_url = f\"https://console.cloud.google.com/apigee/analytics/custom-reports?project={APIGEE_ORG}\"\n",
    "cost_trs = \"\".join(\n",
    "    \"<tr><td><code>\" + safe_text(r[\"model\"]) + \"</code></td><td>\" + safe_text(r[\"user\"]) + \"</td><td>\"\n",
    "    + f\"{r['messages']:,}\" + \"</td><td>$\" + f\"{r['request_cost']:.4f}\" + \"</td><td>$\"\n",
    "    + f\"{r['response_cost']:.4f}\" + \"</td><td><strong>$\" + f\"{r['total_cost']:.4f}\" + \"</strong></td></tr>\"\n",
    "    for r in cost_rows\n",
    ")\n",
    "lat_trs = \"\".join(\n",
    "    \"<tr><td><code>\" + safe_text(r[\"proxy\"]) + \"</code></td><td><code>\" + safe_text(r[\"model\"]) + \"</code></td><td>\"\n",
    "    + safe_text(r[\"response_type\"]) + \"</td><td>\" + f\"{r['messages']:,}\" + \"</td><td>\"\n",
    "    + f\"{r['total_tokens']:,}\" + \"</td><td><strong>\" + f\"{r['ttft_ms']:.0f}\" + \" ms</strong></td></tr>\"\n",
    "    for r in latency_rows\n",
    ")\n",
    "\n",
    "render_utf8_html(\n",
    "    f'<div class=\"agw-card\"><div class=\"agw-header\" style=\"background:linear-gradient(135deg,#174ea6 0%,#1a73e8 100%);color:#fff;\">'\n",
    "    f'<div><div class=\"agw-title\" style=\"font-size:18px;color:#fff;\">🏛️ Apigee Unified AI Gateway — Executive FinOps & Governance Dashboard</div>'\n",
    "    f'<div class=\"agw-subtitle\" style=\"color:#e8f0fe;\">Org: {safe_text(APIGEE_ORG)} | Env: {safe_text(APIGEE_ENVIRONMENT)} | Window: {safe_text(TIME_RANGE_WINDOW)} | '\n",
    "    f'<a href=\"{safe_text(console_url)}\" target=\"_blank\" style=\"color:#fff;text-decoration:underline;\">Open Custom Reports Console ↗</a></div></div>{src_badge}</div>'\n",
    "    f'<div class=\"agw-body\"><div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:16px;\">'\n",
    "    f'<div class=\"agw-box\" style=\"margin:0;border-left:4px solid #137333;background:#f8f9fa;\"><strong>💰 Total AI Token Spend</strong><br><span style=\"font-size:22px;font-weight:800;color:#137333;\">${tot_spend:.4f}</span><br><span style=\"font-size:12px;color:#5f6368;\">In: ${tot_in_cost:.4f} | Out: ${tot_out_cost:.4f}</span></div>'\n",
    "    f'<div class=\"agw-box\" style=\"margin:0;border-left:4px solid #1a73e8;background:#f8f9fa;\"><strong>🔢 Total Token Throughput</strong><br><span style=\"font-size:22px;font-weight:800;color:#1a73e8;\">{tot_tokens:,}</span><br><span style=\"font-size:12px;color:#5f6368;\">In: {tot_in_tok:,} | Out: {tot_out_tok:,} ({tot_reqs:,} calls)</span></div>'\n",
    "    f'<div class=\"agw-box\" style=\"margin:0;border-left:4px solid #f9ab00;background:#f8f9fa;\"><strong>⚡ Weighted Avg TTFT</strong><br><span style=\"font-size:22px;font-weight:800;color:#b06000;\">{avg_ttft:.0f} ms</span><br><span style=\"font-size:12px;color:#5f6368;\">SLO (&le;{LATENCY_SLO_TARGET_MS} ms): {slo_pct:.1f}%</span></div>'\n",
    "    f'<div class=\"agw-box\" style=\"margin:0;border-left:4px solid #9334e6;background:#f8f9fa;\"><strong>🛡️ Policy Shield Blocks</strong><br><span style=\"font-size:22px;font-weight:800;color:#9334e6;\">{blocked:,} ({block_pct:.1f}%)</span><br><span style=\"font-size:12px;color:#5f6368;\">Armor: {cnt_armor} | Auth: {cnt_auth} | Quota: {cnt_quota}</span></div>'\n",
    "    f'</div><div style=\"text-align:center;margin-bottom:16px;\"><img src=\"data:image/png;base64,{chart_b64}\" style=\"max-width:100%;height:auto;border:1px solid #e8eaed;border-radius:8px;\" alt=\"Apigee AI Executive Charts\"/></div>'\n",
    "    f'<table class=\"agw-table\" style=\"margin-bottom:14px;\"><tr><th>Model (Report 1: FinOps)</th><th>Consumer</th><th>Calls</th><th>Prompt Cost</th><th>Output Cost</th><th>Total Cost</th></tr>{cost_trs}</table>'\n",
    "    f'<table class=\"agw-table\"><tr><th>API Proxy (Report 2: Latency)</th><th>Model</th><th>Mode</th><th>Calls</th><th>Total Tokens</th><th>Avg TTFT</th></tr>{lat_trs}</table>'\n",
    "    f'</div></div>'\n",
    ")"
