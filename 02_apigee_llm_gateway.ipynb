    "def safe_text(val: Any) -> str:\n",
    "    txt = val.decode(\"utf-8\", errors=\"replace\") if isinstance(val, (bytes, bytearray)) else str(val if val is not None else \"\")\n",
    "    return html.escape(txt)\n",
    "\n",
    "\n",
    "_ACTIVE_BANNER: Optional[\"ProgressBanner\"] = None\n",
    "\n",
    "\n",
    "class ProgressBanner:\n",
    "    \"\"\"Renders and updates a live in-progress banner in the active Colab cell.\"\"\"\n",
    "\n",
    "    def __init__(self, title: str, detail: str = \"Initializing...\") -> None:\n",
    "        self.title = title\n",
    "        self.t0 = time.perf_counter()\n",
    "        self.handle = display(HTML(self._build_html(detail)), display_id=True)\n",
    "\n",
    "    def _build_html(self, detail: str, extra_html: str = \"\", badge: str = \"⏳ IN PROGRESS\") -> str:\n",
    "        elapsed = time.perf_counter() - self.t0\n",
    "        t_safe, d_safe, b_safe = safe_text(self.title), safe_text(detail), safe_text(badge)\n",
    "        return (\n",
    "            f'<meta charset=\"utf-8\">{UI_STYLES}'\n",
    "            f'<div class=\"agw-card\"><div class=\"agw-header\">'\n",
    "            f'<div style=\"display:flex;align-items:center;gap:12px;\"><span class=\"agw-spin\"></span>'\n",
    "            f'<div><div class=\"agw-title\">{t_safe}</div>'\n",
    "            f'<div class=\"agw-subtitle\">{d_safe} ({elapsed:.1f}s elapsed)</div></div></div>'\n",
    "            f'<span class=\"agw-badge agw-progress\">{b_safe}</span></div>'\n",
    "            f'<div class=\"agw-pbar\"><div class=\"agw-pbar-fill\"></div></div>{extra_html}</div>'\n",
    "        )\n",
    "\n",
    "    def update(self, detail: str, extra_html: str = \"\", badge: str = \"⏳ IN PROGRESS\") -> None:\n",
    "        if self.handle is not None:\n",
    "            self.handle.update(HTML(self._build_html(detail, extra_html=extra_html, badge=badge)))\n",
    "\n",
    "    def finish(self, final_content_html: str) -> None:\n",
    "        if self.handle is not None:\n",
    "            self.handle.update(HTML(f'<meta charset=\"utf-8\">{UI_STYLES}{final_content_html}'))\n",
    "            self.handle = None\n",
    "\n",
    "\n",
    "def start_progress(title: str, detail: str = \"Starting execution...\") -> ProgressBanner:\n",
    "    global _ACTIVE_BANNER\n",
    "    _ACTIVE_BANNER = ProgressBanner(title, detail)\n",
    "    return _ACTIVE_BANNER\n",
    "\n",
    "\n",
    "def update_progress(detail: str, extra_html: str = \"\", badge: str = \"⏳ IN PROGRESS\") -> None:\n",
    "    if _ACTIVE_BANNER is not None:\n",
    "        _ACTIVE_BANNER.update(detail, extra_html=extra_html, badge=badge)\n",
    "\n",
    "\n",
    "def render_utf8_html(content_html: str) -> None:\n",
    "    global _ACTIVE_BANNER\n",
    "    if _ACTIVE_BANNER is not None and _ACTIVE_BANNER.handle is not None:\n",
    "        banner = _ACTIVE_BANNER\n",
    "        _ACTIVE_BANNER = None\n",
    "        banner.finish(content_html)\n",
    "    else:\n",
    "        display(HTML(f'<meta charset=\"utf-8\">{UI_STYLES}{content_html}'))\n",
    "\n",
    "\n",
    "def show_status_card(\n",
    "    status: str, title: str, subtitle: str, rows: Optional[list[tuple[str, str]]] = None, remediation: str = \"\", raw_details: str = \"\"\n",
    ") -> None:\n",
    "    badge_text, badge_cls = {\n",
    "        \"PASS\": (\"✅ PASS\", \"agw-pass\"),\n",
    "        \"POLICY\": (\"🛡️ POLICY VERIFIED\", \"agw-policy\"),\n",
    "        \"CACHE\": (\"⚡ SEMANTIC CACHE HIT\", \"agw-cache\"),\n",
    "        \"FAIL\": (\"❌ FAIL — ACTION NEEDED\", \"agw-fail\"),\n",
    "    }.get(status, (\"ℹ️ INFO\", \"agw-cache\"))\n",
    "    rows_html = \"\".join(f\"<tr><th>{safe_text(k)}</th><td>{safe_text(v)}</td></tr>\" for k, v in (rows or []))\n",
    "    tbl = f'<table class=\"agw-table\">{rows_html}</table>' if rows_html else \"\"\n",
    "    fix = f'<div class=\"agw-box agw-box-fix\"><strong>🛠️ How to Fix This (Plain Language):</strong><br>{safe_text(remediation)}</div>' if remediation else \"\"\n",
    "    det = f'<details class=\"agw-details\"><summary>View Technical Log Details (Optional)</summary><pre>{safe_text(raw_details)}</pre></details>' if raw_details else \"\"\n",
    "    render_utf8_html(\n",
    "        f'<div class=\"agw-card\"><div class=\"agw-header\"><div><div class=\"agw-title\">{safe_text(title)}</div>'\n",
    "        f'<div class=\"agw-subtitle\">{safe_text(subtitle)}</div></div><span class=\"agw-badge {badge_cls}\">{badge_text}</span></div>'\n",
    "        f'<div class=\"agw-body\">{tbl}{fix}{det}</div></div>'\n",
    "    )\n",
    "\n",
    "\n",
    "def fail_step(title: str, what_happened: str, how_to_fix: str, raw_details: str = \"\") -> None:\n",
