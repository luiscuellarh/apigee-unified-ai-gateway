    "def upsert_sdp_inspect_template(template_id: str, location: str, min_likelihood: str) -> tuple[str, str]:\n",
    "    \"\"\"Creates or updates a regional Cloud Sensitive Data Protection (DLP v2) InspectTemplate.\"\"\"\n",
    "    clean_id = template_id.strip().split(\"/\")[-1].strip()\n",
    "    if not re.fullmatch(r\"[a-zA-Z0-9_-]{1,100}\", clean_id):\n",
    "        fail_step(\n",
    "            \"Invalid SDP Inspect Template ID\",\n",
    "            f\"'{template_id}' is not a valid Sensitive Data Protection template ID.\",\n",
    "            \"Use 1–100 letters, digits, hyphens, or underscores.\",\n",
    "        )\n",
    "    loc = location.strip() or REGION\n",
    "    col_url = f\"https://dlp.googleapis.com/v2/projects/{PROJECT_ID}/locations/{loc}/inspectTemplates\"\n",
    "    item_url = f\"{col_url}/{clean_id}\"\n",
    "    q_headers = {\"x-goog-user-project\": PROJECT_ID}\n",
    "    inspect_tpl: dict[str, Any] = {\n",
    "        \"displayName\": f\"Apigee AI Gateway Inspect ({clean_id})\",\n",
    "        \"description\": \"PII inspection template for Apigee Unified AI Gateway prompts and responses\",\n",
    "        \"inspectConfig\": {\n",
    "            \"infoTypes\": [{\"name\": it} for it in SDP_DEFAULT_INFOTYPES],\n",
    "            \"minLikelihood\": min_likelihood,\n",
    "        },\n",
    "    }\n",
    "\n",
    "    g_s, g_d = gcp_json_request(\"GET\", item_url, extra_headers=q_headers)\n",
    "    if g_s == 200:\n",
    "        u_s, u_d = gcp_json_request(\n",
    "            \"PATCH\",\n",
    "            item_url,\n",
    "            json_body={\"inspectTemplate\": inspect_tpl, \"updateMask\": \"displayName,description,inspectConfig\"},\n",
    "            extra_headers=q_headers,\n",
    "        )\n",
    "        if u_s == 200:\n",
    "            res_name = str(u_d.get(\"name\") or f\"projects/{PROJECT_ID}/locations/{loc}/inspectTemplates/{clean_id}\")\n",
    "            return \"Updated Existing\", res_name\n",
    "        res_name = str(g_d.get(\"name\") or f\"projects/{PROJECT_ID}/locations/{loc}/inspectTemplates/{clean_id}\")\n",
    "        return \"Verified Existing\", res_name\n",
    "\n",
    "    c_s, c_d = gcp_json_request(\n",
    "        \"POST\", col_url, json_body={\"templateId\": clean_id, \"inspectTemplate\": inspect_tpl}, extra_headers=q_headers\n",
    "    )\n",
    "    if c_s in (200, 201):\n",
    "        res_name = str(c_d.get(\"name\") or f\"projects/{PROJECT_ID}/locations/{loc}/inspectTemplates/{clean_id}\")\n",
    "        return \"Created\", res_name\n",
    "\n",
    "    fail_step(\n",
    "        f\"Could Not Create SDP Inspect Template '{clean_id}'\",\n",
    "        f\"Sensitive Data Protection API in '{loc}' returned HTTP {c_s}.\",\n",
    "        f\"Verify that dlp.googleapis.com is enabled on '{PROJECT_ID}', '{loc}' is a valid GCP region, \"\n",
    "        \"and your account has DLP Admin or DLP Inspect Templates Editor permissions.\",\n",
    "        json.dumps(c_d, indent=2),\n",
    "    )\n",
    "    return \"\", \"\"\n",
    "\n",
    "\n",
